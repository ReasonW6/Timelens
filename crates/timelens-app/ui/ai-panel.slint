import { ComboBox, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme, Action, Label, Note, SectionTitle, Rule, CheckBox, StatusLine, Segmented, Segment, Switch, SettingRow, SettingsHeader, SettingsGroup, SettingExpander } from "theme.slint";

export global AiState {
    in-out property <bool> open: false;
    in-out property <int> page: 0;
    in-out property <string> status: "配置提供商后即可开始。计划默认关闭。";
    in-out property <[string]> providers;
    in-out property <int> provider-index: -1;
    in-out property <int> preset-index: 0;
    in-out property <string> provider-name: "OpenAI";
    in-out property <string> endpoint: "https://api.openai.com/v1";
    in-out property <int> protocol-index: 0;
    in-out property <string> api-key;
    in-out property <string> secret-headers;
    in-out property <bool> replace-credentials: false;
    in-out property <bool> local-http: false;
    in-out property <bool> azure: false;
    in-out property <[string]> models;
    in-out property <int> model-index: -1;
    in-out property <string> model-id;
    in-out property <int> vision: 0;
    in-out property <int> reasoning: 0;
    in-out property <int> tools: 0;
    in-out property <string> context-tokens: "32768";
    in-out property <bool> temperature-supported: false;
    in-out property <bool> effort-supported: false;
    in-out property <string> temperature;
    in-out property <string> max-output: "4096";
    in-out property <int> effort: 0;
    in-out property <string> retries: "3";
    in-out property <string> idle-timeout;
    in-out property <[string]> prompts;
    in-out property <int> prompt-index: 0;
    in-out property <string> prompt-name: "Timelens 默认";
    in-out property <string> prompt-text;
    in-out property <string> language: "简体中文";
    in-out property <string> range-start;
    in-out property <string> range-end;
    in-out property <string> preflight: "先点击「预览发送内容」，查看范围、覆盖率及预计请求数。";
    in-out property <bool> prepared: false;
    in-out property <string> image-count: "本次没有图片";
    in-out property <[string]> image-options;
    in-out property <int> image-index: -1;
    in-out property <image> image-preview;
    in-out property <bool> image-previewed: false;
    in-out property <string> image-detail;
    in-out property <[string]> jobs;
    in-out property <int> job-index: -1;
    in-out property <[string]> versions;
    in-out property <int> version-index: -1;
    in-out property <bool> pinned: false;
    in-out property <[string]> branches;
    in-out property <int> branch-index: 0;
    in-out property <string> conversation;
    in-out property <string> exposed-reasoning;
    in-out property <string> token-label: "Token 用量尚不可用";
    in-out property <string> source-label;
    in-out property <string> question;
    in-out property <bool> daily: false;
    in-out property <string> daily-time: "22:00";
    in-out property <bool> interval: false;
    in-out property <string> interval-hours: "1";
    in-out property <string> daily-retries;
    in-out property <string> interval-retries;
    in-out property <string> schedule-status;
    in-out property <bool> compression: true;
    in-out property <string> recent-messages;
    in-out property <string> retention-days: "30";
    in-out property <string> retention-mib: "100";
    in-out property <string> version-limit: "3";
    in-out property <bool> notify-success: false;
    in-out property <bool> notify-failure: true;
    callback opened;
    callback choose-provider(int);
    callback choose-preset(int);
    callback choose-model(int);
    callback save-provider;
    callback delete-provider;
    callback test-provider;
    callback fetch-models;
    callback choose-prompt(int);
    callback save-prompt;
    callback new-prompt;
    callback reset-prompt;
    callback delete-prompt;
    callback prepare;
    callback send-summary;
    callback list-images;
    callback preview-image;
    callback authorize-image;
    callback clear-images;
    callback choose-job(int);
    callback choose-version(int);
    callback choose-branch(int);
    callback cancel-job;
    callback regenerate;
    callback follow-up;
    callback pin-version;
    callback delete-version;
    callback clear-conversation;
    callback clear-context;
    callback save-daily;
    callback save-interval;
    callback save-settings;
}

// Keep native text editing and selection while giving every single-line field
// an explicit height. A ScrollView must not stretch a short form into tall inputs.
component AiField inherits LineEdit {
    min-height: 36px;
    max-height: 36px;
    min-width: 0px;
    vertical-stretch: 0;
    font-size: 14px;
}

component AiSelect inherits ComboBox {
    min-height: 36px;
    max-height: 36px;
    min-width: 0px;
    vertical-stretch: 0;
}

component AiCheck inherits CheckBox {
    vertical-stretch: 0;
    font-size: 14px;
}

export component AiPanel inherits Rectangle {
    // The settings center shows only the connection and preferences.
    in property <bool> settings-mode: false;
    private property <bool> connection-options-open: false;
    private property <bool> model-options-open: false;
    private property <bool> reasoning-open: false;
    private property <bool> delete-provider-open: false;
    private property <bool> delete-prompt-open: false;
    // Connections and preferences live in the settings center.
    callback open-settings;

    background: Theme.paper;
    clip: true;

    VerticalLayout {
        spacing: 16px;

        if !root.settings-mode : HorizontalLayout {
            vertical-stretch: 0;
            spacing: 16px;
            VerticalLayout {
                spacing: 5px;
                Text { text: "AI 总结"; color: Theme.ink; font-size: 26px; font-weight: 600; vertical-stretch: 0; }
                Note { text: "把一段时间整理成可以回顾的内容。发送前可以预览，结果只保存在本机。"; }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center; Action { text: "AI 设置"; icon: @image-url("icons/settings.svg"); clicked => { root.open-settings(); } } }
        }

        if !root.settings-mode : HorizontalLayout {
            Segmented {
                Segment { text: "总结"; icon: @image-url("icons/sparkles.svg"); selected: AiState.page == 0 || AiState.page == 6; clicked => { AiState.page = 0; } }
                Segment { text: "提示词"; icon: @image-url("icons/file-description.svg"); selected: AiState.page == 2; clicked => { AiState.page = 2; } }
                Segment { text: "计划"; icon: @image-url("icons/calendar.svg"); selected: AiState.page == 3; clicked => { AiState.page = 3; } }
                Segment { text: "历史"; icon: @image-url("icons/history.svg"); selected: AiState.page == 4 || AiState.page == 7 || AiState.page == 8; clicked => { AiState.page = 4; } }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if !root.settings-mode && AiState.page == 0 : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 16px;
                padding-right: 12px;

                if AiState.providers.length == 0 : Rectangle {
                    vertical-stretch: 0;
                    background: Theme.accent-soft;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        SectionTitle { text: "先连接你的 AI 服务"; }
                        Note { text: "选择提供商、填入自己的密钥并测试连接。总结与对话保存在本机，发送前可以预览本次内容。"; }
                        HorizontalLayout {
                            Action { width: 144px; text: "配置 AI 连接"; accent: true; clicked => { root.open-settings(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                if AiState.providers.length > 0 : VerticalLayout {
                    spacing: 14px;
                    SectionTitle { text: "新建时段总结"; }
                    Note { text: "使用本地时间选择开始与结束，再查看将要发送的内容。"; }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 7px;
                            Label { text: "开始时间"; }
                            AiField { text <=> AiState.range-start; accessible-label: "总结开始时间"; placeholder-text: "YYYY-MM-DD HH:MM:SS"; edited => { AiState.prepared = false; } }
                        }
                        VerticalLayout {
                            spacing: 7px;
                            Label { text: "结束时间"; }
                            AiField { text <=> AiState.range-end; accessible-label: "总结结束时间"; placeholder-text: "YYYY-MM-DD HH:MM:SS"; edited => { AiState.prepared = false; } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 7px;
                            Label { text: "AI 连接"; }
                            AiSelect { model: AiState.providers; current-index <=> AiState.provider-index; accessible-label: "本次总结使用的 AI 连接"; selected(value) => { AiState.choose-provider(self.current-index); AiState.prepared = false; } }
                        }
                        VerticalLayout {
                            spacing: 7px;
                            Label { text: "提示词预设"; }
                            AiSelect { model: AiState.prompts; current-index <=> AiState.prompt-index; accessible-label: "本次总结的提示词预设"; selected(value) => { AiState.choose-prompt(self.current-index); AiState.prepared = false; } }
                        }
                    }
                    Note { text: AiState.provider-index < 0 ? "请选择一个已保存的连接，或在「设置 › AI」完成配置。" : "模型 " + AiState.model-id + " · " + (AiState.vision == 1 ? "支持图片" : AiState.vision == 2 ? "仅文本" : "图片能力待确认"); }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { width: 112px; text: "添加快照"; enabled: AiState.provider-index >= 0 && AiState.vision == 1; clicked => { AiState.list-images(); AiState.page = 6; } }
                        Action { width: 132px; text: "移除本次图片"; enabled: AiState.image-count != "本次没有图片"; clicked => { AiState.clear-images(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Note { text: AiState.image-count; }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { width: 144px; text: "预览发送内容"; enabled: AiState.provider-index >= 0 && AiState.range-start != "" && AiState.range-end != ""; clicked => { AiState.prepare(); } }
                        Action { width: 160px; text: "发送并生成总结"; accent: true; enabled: AiState.prepared; clicked => { AiState.send-summary(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle {
                        vertical-stretch: 0;
                        background: Theme.sidebar;
                        border-radius: 5px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            Label { text: AiState.prepared ? "本次发送预览" : "发送前检查"; }
                            Note { text: AiState.preflight; }
                        }
                    }
                }

                Rule { }
                HorizontalLayout {
                    SectionTitle { text: "总结与对话"; vertical-alignment: center; }
                    Action { width: 100px; text: "查看历史"; clicked => { AiState.page = 4; } }
                }
                if AiState.versions.length > 0 : VerticalLayout {
                    spacing: 7px;
                    Label { text: "当前版本"; }
                    AiSelect { model: AiState.versions; current-index <=> AiState.version-index; accessible-label: "当前总结版本"; selected(value) => { AiState.choose-version(self.current-index); } }
                }
                if AiState.source-label != "" : Note { text: AiState.source-label; }
                if AiState.conversation == "" : VerticalLayout {
                    spacing: 8px;
                    padding-top: 12px;
                    padding-bottom: 20px;
                    Label { text: "还没有对话内容"; }
                    Note { text: "生成总结后，可以在这里阅读、保留不同版本，并从选中的节点继续追问。"; }
                }
                if AiState.conversation != "" : TextEdit { text: AiState.conversation; read-only: true; height: 320px; font-size: 15px; wrap: word-wrap; accessible-label: "总结与对话内容"; }
                if AiState.exposed-reasoning != "" : VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        Action { width: 192px; text: root.reasoning-open ? "收起公开推理摘要" : "查看公开推理摘要"; selected: root.reasoning-open; clicked => { root.reasoning-open = !root.reasoning-open; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.reasoning-open : TextEdit { text: AiState.exposed-reasoning; read-only: true; height: 160px; font-size: 14px; wrap: word-wrap; accessible-label: "提供商公开返回的推理或推理摘要"; }
                }
                if AiState.conversation != "" && AiState.exposed-reasoning == "" : Note { text: "提供商未返回公开推理内容。"; }
                if AiState.jobs.length > 0 || AiState.versions.length > 0 : Note { text: AiState.token-label; }
                if AiState.versions.length > 0 : VerticalLayout {
                    spacing: 12px;
                    Rule { }
                    SectionTitle { text: "继续这段对话"; }
                    Label { text: "从哪个节点继续"; }
                    AiSelect { model: AiState.branches; current-index <=> AiState.branch-index; accessible-label: "追问的起始节点"; selected(value) => { AiState.choose-branch(self.current-index); } }
                    Label { text: "你的问题"; }
                    TextEdit { text <=> AiState.question; height: 104px; font-size: 14px; wrap: word-wrap; placeholder-text: "围绕这份总结继续提问…"; enabled: AiState.version-index >= 0; accessible-label: "继续提问的内容"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { width: 112px; text: "继续提问"; accent: true; enabled: AiState.version-index >= 0 && AiState.question != ""; clicked => { AiState.follow-up(); } }
                        Action { width: 112px; text: "重新生成"; clicked => { AiState.regenerate(); } }
                        Action { width: 144px; text: "取消当前任务"; enabled: AiState.jobs.length > 0; clicked => { AiState.cancel-job(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { width: 112px; text: AiState.pinned ? "取消固定" : "固定版本"; selected: AiState.pinned; enabled: AiState.version-index >= 0; clicked => { AiState.pin-version(); } }
                        Action { width: 160px; text: "清除后续上下文"; enabled: AiState.version-index >= 0; clicked => { AiState.clear-context(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if AiState.versions.length == 0 && AiState.jobs.length > 0 : HorizontalLayout {
                    spacing: 8px;
                    Action { width: 144px; text: "取消当前任务"; clicked => { AiState.cancel-job(); } }
                    Action { width: 112px; text: "重新生成"; clicked => { AiState.regenerate(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 8px; }
            }
        }

        if root.settings-mode : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 10px;
                padding-right: 18px;
                padding-bottom: 16px;

                SettingsHeader { text: "连接"; }
                Note { text: "使用你自己的提供商和密钥。密钥只保存在 Windows 凭据管理器；连接测试只发送合成数据。"; font-size: 12px; }
                SettingsGroup {
                    SettingRow {
                        title: "已保存的连接";
                        description: AiState.providers.length == 0 ? "还没有连接，先从右侧选择一个提供商。" : "选择要编辑的连接。";
                        icon: @image-url("icons/plug-connected.svg");
                        AiSelect { width: 220px; model: AiState.providers; current-index <=> AiState.provider-index; enabled: AiState.providers.length > 0; accessible-label: "已保存的 AI 连接"; selected(value) => { AiState.choose-provider(self.current-index); AiState.prepared = false; root.delete-provider-open = false; } }
                    }
                    Rule { }
                    SettingRow {
                        title: "新建连接";
                        description: "按提供商预填服务地址与协议。";
                        icon: @image-url("icons/sparkles.svg");
                        AiSelect { width: 220px; model: ["OpenAI", "Anthropic Claude", "Google Gemini", "Azure OpenAI", "OpenRouter", "DeepSeek", "硅基流动", "Moonshot / Kimi", "自定义"]; current-index <=> AiState.preset-index; accessible-label: "新增 AI 连接的提供商类型"; selected(value) => { AiState.choose-preset(self.current-index); AiState.prepared = false; root.delete-provider-open = false; } }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: "连接信息"; }
                SettingsGroup {
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout { spacing: 6px; Label { text: "连接名称"; font-size: 13px; } AiField { text <=> AiState.provider-name; placeholder-text: "例如：我的 OpenAI"; accessible-label: "AI 连接名称"; } }
                            VerticalLayout { spacing: 6px; Label { text: "接口协议"; font-size: 13px; } AiSelect { model: ["OpenAI 兼容", "Anthropic 原生 / 兼容", "Gemini 原生 / 兼容"]; current-index <=> AiState.protocol-index; accessible-label: "AI 接口协议"; } }
                        }
                        VerticalLayout { spacing: 6px; Label { text: "服务地址"; font-size: 13px; } AiField { text <=> AiState.endpoint; placeholder-text: "HTTPS Base URL"; accessible-label: "AI 服务地址"; } }
                        VerticalLayout {
                            spacing: 6px;
                            Label { text: "API 密钥"; font-size: 13px; }
                            AiField { text <=> AiState.api-key; input-type: password; placeholder-text: "留空则保留已保存的密钥"; accessible-label: "AI API 密钥"; }
                        }
                        AiCheck { text: "用上面填写的密钥替换已保存的凭据"; font-size: 13px; checked <=> AiState.replace-credentials; }
                    }
                    Rule { }
                    SettingExpander {
                        title: "高级连接选项";
                        description: "Azure、本机 HTTP 服务与秘密请求头。";
                        icon: @image-url("icons/adjustments-horizontal.svg");
                        expanded <=> root.connection-options-open;
                        AiCheck { text: "此端点为 Azure OpenAI"; font-size: 13px; checked <=> AiState.azure; }
                        AiCheck { text: "允许本机 HTTP（仅 localhost / 127.0.0.1，无 TLS 保护）"; font-size: 13px; checked <=> AiState.local-http; }
                        VerticalLayout { spacing: 6px; Label { text: "秘密请求头（可选）"; font-size: 13px; } AiField { text <=> AiState.secret-headers; input-type: password; placeholder-text: "X-Tenant=value；多个用分号分隔"; accessible-label: "可选秘密请求头"; } }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: "模型"; }
                SettingsGroup {
                    VerticalLayout {
                        padding: 16px; spacing: 12px;
                        VerticalLayout {
                            spacing: 6px;
                            Label { text: "模型 ID"; font-size: 13px; }
                            HorizontalLayout {
                                spacing: 8px;
                                AiField { text <=> AiState.model-id; placeholder-text: "填写模型 ID，或从目录选择"; accessible-label: "AI 模型 ID"; }
                                Action { text: "读取模型目录"; clicked => { AiState.fetch-models(); } }
                            }
                        }
                        if AiState.models.length > 0 : VerticalLayout {
                            spacing: 6px;
                            Label { text: "模型目录"; font-size: 13px; }
                            AiSelect { model: AiState.models; current-index <=> AiState.model-index; accessible-label: "AI 模型目录"; selected(value) => { AiState.choose-model(self.current-index); AiState.prepared = false; } }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout { spacing: 6px; Label { text: "图片能力"; font-size: 13px; } AiSelect { model: ["待确认", "支持", "不支持"]; current-index <=> AiState.vision; accessible-label: "模型图片能力"; } }
                            VerticalLayout { spacing: 6px; Label { text: "公开推理"; font-size: 13px; } AiSelect { model: ["待确认", "支持", "不支持"]; current-index <=> AiState.reasoning; accessible-label: "模型公开推理能力"; } }
                            VerticalLayout { spacing: 6px; Label { text: "工具能力"; font-size: 13px; } AiSelect { model: ["待确认", "支持", "不支持"]; current-index <=> AiState.tools; accessible-label: "模型工具能力"; } }
                        }
                        Note { text: "未确认的能力不会视为支持。Timelens 不执行模型工具调用。"; font-size: 12px; }
                    }
                    Rule { }
                    SettingExpander {
                        title: "模型高级参数";
                        description: "上下文窗口、输出长度、温度、推理强度与重试。";
                        icon: @image-url("icons/adjustments-horizontal.svg");
                        expanded <=> root.model-options-open;
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout { spacing: 6px; Label { text: "上下文窗口（Token）"; font-size: 13px; } AiField { text <=> AiState.context-tokens; input-type: number; accessible-label: "上下文窗口 Token 数"; } }
                            VerticalLayout { spacing: 6px; Label { text: "最大输出（Token）"; font-size: 13px; } AiField { text <=> AiState.max-output; input-type: number; accessible-label: "最大输出 Token 数"; } }
                        }
                        AiCheck { text: "模型支持 temperature"; font-size: 13px; checked <=> AiState.temperature-supported; }
                        if AiState.temperature-supported : VerticalLayout { spacing: 6px; Label { text: "温度（0–2）"; font-size: 13px; } AiField { text <=> AiState.temperature; placeholder-text: "留空使用提供商默认值"; accessible-label: "模型温度"; } }
                        AiCheck { text: "模型支持 OpenAI reasoning_effort"; font-size: 13px; checked <=> AiState.effort-supported; }
                        if AiState.effort-supported : VerticalLayout { spacing: 6px; Label { text: "推理强度"; font-size: 13px; } AiSelect { model: ["提供商默认", "low", "medium", "high"]; current-index <=> AiState.effort; accessible-label: "模型推理强度"; } }
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout { spacing: 6px; Label { text: "自动重试（0–10 次）"; font-size: 13px; } AiField { text <=> AiState.retries; input-type: number; accessible-label: "AI 自动重试次数"; } }
                            VerticalLayout { spacing: 6px; Label { text: "无响应超时（秒）"; font-size: 13px; } AiField { text <=> AiState.idle-timeout; placeholder-text: "留空表示不限"; accessible-label: "AI 无响应超时秒数"; } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Action { text: "保存并测试"; accent: true; clicked => { AiState.test-provider(); } }
                    Action { text: "仅保存"; clicked => { AiState.save-provider(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { text: "删除连接…"; icon: @image-url("icons/trash.svg"); danger: true; enabled: AiState.provider-index >= 0; clicked => { root.delete-provider-open = true; } }
                }
                if root.delete-provider-open : SettingsGroup {
                    border-color: #c8352f2e;
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Label { text: "删除这个连接及其凭据？"; color: Theme.danger; font-weight: 600; }
                        Note { text: "引用它的计划会暂停，历史总结仍会保留。此操作无法撤销。"; }
                        HorizontalLayout {
                            spacing: 8px;
                            Action { text: "保留连接"; clicked => { root.delete-provider-open = false; } }
                            Action { text: "确认删除"; accent: true; danger: true; clicked => { AiState.delete-provider(); root.delete-provider-open = false; } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: "对话与保留"; }
                SettingsGroup {
                    SettingRow {
                        title: "自动压缩长对话";
                        description: "保留原始消息树，只为后续请求整理上下文。";
                        icon: @image-url("icons/sparkles.svg");
                        Switch { label: "自动压缩长对话"; checked: AiState.compression; toggled(on) => { AiState.compression = on; } }
                    }
                    Rule { }
                    SettingRow {
                        title: "保留最近消息数";
                        description: "留空表示不限。";
                        icon: @image-url("icons/history.svg");
                        AiField { width: 120px; text <=> AiState.recent-messages; placeholder-text: "不限"; accessible-label: "上下文保留的最近消息条数"; }
                    }
                    Rule { }
                    SettingRow {
                        title: "AI 记录保留";
                        description: "天数留空表示永久；固定的版本不会被自动删除。";
                        icon: @image-url("icons/database.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            AiField { width: 96px; text <=> AiState.retention-days; placeholder-text: "永久"; accessible-label: "AI 记录保留天数"; }
                            Text { text: "天"; color: Theme.ink-3; vertical-alignment: center; }
                            AiField { width: 96px; text <=> AiState.retention-mib; placeholder-text: "100"; accessible-label: "AI 数据空间上限 MiB"; }
                            Text { text: "MiB"; color: Theme.ink-3; vertical-alignment: center; }
                        }
                    }
                    Rule { }
                    SettingRow {
                        title: "每个时段保留的版本数";
                        icon: @image-url("icons/layout-grid.svg");
                        AiField { width: 120px; text <=> AiState.version-limit; placeholder-text: "3"; accessible-label: "每个时段保留的成功版本数量"; }
                    }
                    Rule { }
                    SettingRow {
                        title: "任务完成通知";
                        description: "总结任务结束时在托盘提示。";
                        icon: @image-url("icons/info-circle.svg");
                        HorizontalLayout {
                            spacing: 16px;
                            AiCheck { text: "成功"; font-size: 13px; checked <=> AiState.notify-success; }
                            AiCheck { text: "失败"; font-size: 13px; checked <=> AiState.notify-failure; }
                        }
                    }
                }
                HorizontalLayout { Action { text: "保存偏好"; accent: true; clicked => { AiState.save-settings(); } } Rectangle { horizontal-stretch: 1; } }
            }
        }

        if !root.settings-mode && AiState.page == 2 : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 16px;
                padding-right: 12px;
                SectionTitle { text: "按你的方式整理总结"; }
                Note { text: "为不同用途保存提示词预设。修改只影响之后创建的任务。"; }
                VerticalLayout {
                    spacing: 7px;
                    Label { text: "当前预设"; }
                    AiSelect { model: AiState.prompts; current-index <=> AiState.prompt-index; accessible-label: "当前提示词预设"; selected(value) => { AiState.choose-prompt(self.current-index); root.delete-prompt-open = false; } }
                }
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout { spacing: 7px; Label { text: "预设名称"; } AiField { text <=> AiState.prompt-name; placeholder-text: "为这个预设命名"; accessible-label: "提示词预设名称"; } }
                    VerticalLayout { spacing: 7px; Label { text: "输出语言"; } AiField { text <=> AiState.language; placeholder-text: "例如：简体中文"; accessible-label: "总结输出语言"; } }
                }
                Label { text: "提示词正文"; }
                TextEdit { text <=> AiState.prompt-text; height: 280px; font-size: 14px; wrap: word-wrap; accessible-label: "提示词正文"; }
                Note { text: "只读变量 {{range}}、{{coverage}}、{{language}}。编辑提示词不会改变数据过滤和图片授权边界。"; }
                HorizontalLayout {
                    spacing: 8px;
                    Action { width: 100px; text: "保存预设"; accent: true; clicked => { AiState.save-prompt(); } }
                    Action { width: 120px; text: "另存新预设"; clicked => { AiState.new-prompt(); } }
                    Action { width: 144px; text: "恢复官方正文"; clicked => { AiState.reset-prompt(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 80px; text: "删除"; danger: true; enabled: AiState.prompt-index >= 0; clicked => { root.delete-prompt-open = true; } }
                }
                if root.delete-prompt-open : VerticalLayout {
                    spacing: 10px;
                    Label { text: "删除当前提示词预设？"; color: Theme.danger; }
                    Note { text: "引用此预设的计划会暂停。历史总结保留。"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { width: 112px; text: "保留预设"; clicked => { root.delete-prompt-open = false; } }
                        Action { width: 112px; text: "确认删除"; danger: true; clicked => { AiState.delete-prompt(); root.delete-prompt-open = false; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Rectangle { height: 8px; }
            }
        }

        if !root.settings-mode && AiState.page == 3 : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 16px;
                padding-right: 12px;
                SectionTitle { text: "按时整理你的记录"; }
                Note { text: "保存计划时固定当前连接、模型与提示词。每日和间隔计划可以使用不同配置，定时任务只发送文本。"; }
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout { spacing: 7px; Label { text: "本次保存使用的连接"; } AiSelect { model: AiState.providers; current-index <=> AiState.provider-index; accessible-label: "计划使用的 AI 连接"; selected(value) => { AiState.choose-provider(self.current-index); } } }
                    VerticalLayout { spacing: 7px; Label { text: "提示词预设"; } AiSelect { model: AiState.prompts; current-index <=> AiState.prompt-index; accessible-label: "计划使用的提示词预设"; selected(value) => { AiState.choose-prompt(self.current-index); } } }
                }
                if AiState.providers.length == 0 : Note { text: "先在「连接」页配置并测试 AI 服务，再启用计划。"; }
                Rule { }
                AiCheck { text: "启用每日总结"; checked <=> AiState.daily; }
                Note { text: "在指定时间总结前一个完整本地自然日。夏令时日期可能为 23 或 25 小时。"; }
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout { spacing: 7px; Label { text: "每天执行时间"; } AiField { text <=> AiState.daily-time; placeholder-text: "HH:MM，例如 22:00"; accessible-label: "每日总结的本地执行时间"; } }
                    VerticalLayout { spacing: 7px; Label { text: "重试次数（0–10 次）"; } AiField { text <=> AiState.daily-retries; placeholder-text: "留空跟随提供商"; accessible-label: "每日计划重试次数"; } }
                }
                HorizontalLayout { Action { width: 144px; text: "保存每日计划"; clicked => { AiState.save-daily(); } } Rectangle { horizontal-stretch: 1; } }
                Rule { }
                AiCheck { text: "启用固定间隔总结"; checked <=> AiState.interval; }
                Label { text: "快捷间隔（小时）"; }
                HorizontalLayout {
                    spacing: 6px;
                    for hours in [1, 2, 3, 4, 6, 8, 12, 24] : Action { width: 48px; text: hours + ""; selected: AiState.interval-hours == hours + ""; clicked => { AiState.interval-hours = hours; } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout { spacing: 7px; Label { text: "自定义间隔（1–168 小时）"; } AiField { text <=> AiState.interval-hours; input-type: number; accessible-label: "间隔总结的小时数"; } }
                    VerticalLayout { spacing: 7px; Label { text: "重试次数（0–10 次）"; } AiField { text <=> AiState.interval-retries; placeholder-text: "留空跟随提供商"; accessible-label: "间隔计划重试次数"; } }
                }
                Note { text: "首次启用不追溯历史。修改周期会重新建立起点；恢复后只补最近一个完整时段，更早时段记为已错过。"; }
                HorizontalLayout { Action { width: 144px; text: "保存间隔计划"; clicked => { AiState.save-interval(); } } Rectangle { horizontal-stretch: 1; } }
                if AiState.schedule-status != "" : Note { text: AiState.schedule-status; }
                Rectangle { height: 8px; }
            }
        }

        if !root.settings-mode && AiState.page == 4 : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 16px;
                padding-right: 12px;
                SectionTitle { text: "任务与历史版本"; }
                Note { text: "查看任务记录，回到已保存的总结，或管理它的独立分支。"; }
                if AiState.jobs.length == 0 : VerticalLayout {
                    spacing: 12px;
                    padding-top: 12px;
                    padding-bottom: 16px;
                    Label { text: "还没有 AI 任务"; }
                    Note { text: "选择一个时间范围并生成总结，任务与结果就会保存在这里。"; }
                    HorizontalLayout { Action { width: 144px; text: "新建时段总结"; accent: true; clicked => { AiState.page = 0; } } Rectangle { horizontal-stretch: 1; } }
                }
                if AiState.jobs.length > 0 : VerticalLayout {
                    spacing: 12px;
                    Label { text: "任务记录"; }
                    AiSelect { model: AiState.jobs; current-index <=> AiState.job-index; accessible-label: "AI 任务记录"; selected(value) => { AiState.choose-job(self.current-index); } }
                    if AiState.conversation != "" : TextEdit { text: AiState.conversation; read-only: true; height: 300px; font-size: 15px; wrap: word-wrap; accessible-label: "所选 AI 任务内容"; }
                    if AiState.conversation == "" : Note { text: "所选任务还没有可显示的回答。任务状态显示在页面底部。"; }
                    Note { text: AiState.token-label; }
                    HorizontalLayout { Action { width: 224px; text: "取消所选排队或运行任务"; enabled: AiState.job-index >= 0; clicked => { AiState.cancel-job(); } } Rectangle { horizontal-stretch: 1; } }
                }
                Rule { }
                SectionTitle { text: "成功版本与分支"; }
                if AiState.versions.length == 0 : Note { text: "还没有成功保存的总结版本。"; }
                if AiState.versions.length > 0 : VerticalLayout {
                    spacing: 12px;
                    Label { text: "选择版本"; }
                    AiSelect { model: AiState.versions; current-index <=> AiState.version-index; accessible-label: "历史总结版本"; selected(value) => { AiState.choose-version(self.current-index); } }
                    if AiState.source-label != "" : Note { text: AiState.source-label; }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { width: 160px; text: "打开总结与对话"; accent: true; enabled: AiState.version-index >= 0; clicked => { AiState.page = 0; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { width: 128px; text: "删除当前版本"; danger: true; enabled: AiState.version-index >= 0; clicked => { AiState.page = 7; } }
                        Action { width: 144px; text: "清空该版本追问"; danger: true; enabled: AiState.version-index >= 0; clicked => { AiState.page = 8; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Rectangle { height: 8px; }
            }
        }

        if !root.settings-mode && AiState.page == 6 : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 16px;
                padding-right: 12px;
                SectionTitle { text: "把快照加入这一次总结"; }
                Note { text: "逐张预览后再授权。快照可能包含屏幕文字、通知和个人信息，远端模型可能识别这些内容。每次授权只用于一次请求，追问不会再次发送图片。"; }
                Label { text: "选择快照"; }
                AiSelect { model: AiState.image-options; current-index <=> AiState.image-index; enabled: AiState.image-options.length > 0; accessible-label: "本次准备授权的快照"; selected(value) => { AiState.image-previewed = false; } }
                if AiState.image-options.length == 0 : Note { text: "当前范围没有可用图片。可以返回总结页调整时间范围，或直接生成文本总结。"; }
                HorizontalLayout {
                    Action { width: 160px; text: "预览所选快照"; enabled: AiState.image-index >= 0 && AiState.image-options.length > 0; clicked => { AiState.preview-image(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle {
                    height: 280px;
                    background: Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.line;
                    border-radius: 5px;
                    if AiState.image-previewed : Image { x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px; source: AiState.image-preview; image-fit: contain; }
                    if !AiState.image-previewed : Text { text: "选择一张快照并点击预览"; color: Theme.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                }
                if AiState.image-detail != "" : Note { text: AiState.image-detail; }
                HorizontalLayout {
                    Action { width: 232px; text: "授权此图用于本次请求"; accent: true; enabled: AiState.image-previewed; clicked => { AiState.authorize-image(); AiState.prepared = false; } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Note { text: AiState.image-count; }
                Rule { }
                HorizontalLayout {
                    spacing: 8px;
                    Action { width: 216px; text: "完成选择，返回发送预览"; clicked => { AiState.page = 0; AiState.prepared = false; } }
                    Action { width: 144px; text: "移除本次图片"; clicked => { AiState.clear-images(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 8px; }
            }
        }

        if !root.settings-mode && (AiState.page == 7 || AiState.page == 8) : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 18px;
                padding-right: 12px;
                SectionTitle { text: AiState.page == 7 ? "删除当前版本及其全部分支？" : "删除该版本的全部追问？"; color: Theme.danger; wrap: word-wrap; }
                Note { text: AiState.page == 7 ? "将删除回答、对话、提示词和上下文快照。原始活动和其他版本保留。此操作不可撤销。" : "将删除追问消息与压缩摘要。初始总结、活动数据和其他版本保留。此操作不可撤销。"; }
                if AiState.source-label != "" : Note { text: AiState.source-label; }
                HorizontalLayout {
                    spacing: 8px;
                    Action { width: 128px; text: "返回，保留内容"; clicked => { AiState.page = 4; } }
                    Action { width: 112px; text: "确认删除"; danger: true; enabled: AiState.version-index >= 0; clicked => { if AiState.page == 7 { AiState.delete-version(); } else { AiState.clear-conversation(); } AiState.page = 4; } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        StatusLine { text: AiState.status; }
    }
}
