import { LineEdit } from "std-widgets.slint";
import { Theme, Action, Note, SectionTitle, CheckBox, Segmented, Segment, Switch, SettingRow, SettingsHeader, SettingsGroup, SettingExpander, Rule } from "theme.slint";

export global DataState {
    in-out property <bool> open: false;
    in-out property <bool> busy: false;
    in-out property <string> status;
    in-out property <string> archive;
    in-out property <string> password;
    in-out property <string> password-again;
    in-out property <string> restore-password;
    in-out property <bool> backup-open;
    // The last integrity check's result, in words.
    in-out property <string> integrity;
    // The confirmation open over the window: 1 replace from backup, 2 repair tool.
    in-out property <int> restore-confirm;
    in-out property <bool> snapshots: false;
    in-out property <bool> sensitive-confirmed: false;
    in-out property <bool> restore-ready: false;
    in-out property <bool> replace-confirmed: false;
    in-out property <string> restore-info;
    in-out property <string> current-directory;
    in-out property <string> destination;
    in-out property <bool> recovery-needed: false;
    // Moving the data: 0 idle, 1 moving, 2 moved, 3 failed.
    in-out property <int> move-phase: 0;
    in-out property <float> move-progress: 0;
    in-out property <string> move-step;
    in-out property <string> move-message;
    callback action(int);
    // A running action's progress or result is waiting to be applied.
    callback updates-ready;
}

// Storage, backup and maintenance, as settings sections. The page that
// hosts it provides scrolling and the retention and clearing sections.
export component DataPanel inherits VerticalLayout {
    // The cipher and schema in use, in words.
    in property <string> storage-status;
    spacing: 10px;
    alignment: start;

    SettingsHeader { text: "存储位置"; }
    SettingsGroup {
        SettingRow {
            title: "当前数据目录";
            description: DataState.current-directory != "" ? DataState.current-directory : "正在读取数据位置…";
            icon: @image-url("icons/folder.svg");
        }
        Rule { }
        SettingRow { title: "加密存储"; description: root.storage-status; icon: @image-url("icons/lock.svg"); }
        Rule { }
        SettingExpander {
            title: "迁移到其他位置";
            description: "可以选择本机任意磁盘上的文件夹。迁移期间暂停记录，全部数据复制并校验通过后才会切换。";
            icon: @image-url("icons/arrow-right-circle.svg");
            HorizontalLayout {
                spacing: 8px;
                LineEdit { height: 34px; horizontal-stretch: 1; text <=> DataState.destination; placeholder-text: "例如 D:\\TimelensData"; enabled: !DataState.busy; }
                Action { text: "选择文件夹"; icon: @image-url("icons/folder.svg"); enabled: !DataState.busy; clicked => { DataState.action(11); } }
                Action { text: "开始迁移"; accent: true; enabled: !DataState.busy && DataState.destination != ""; clicked => { DataState.action(9); } }
            }
            Note { text: "所选文件夹里已有其他文件时，数据会放进其中新建的 Timelens 文件夹。外部备份与导出文件会留在原处。"; font-size: 12px; }
        }
    }

    Rectangle { height: 10px; }
    SettingsHeader { text: "备份与恢复"; }
    SettingsGroup {
        SettingExpander {
            title: "创建便携备份";
            description: "ZIP 包含活动、输入、设置和排除规则；登录任务不进入备份。";
            icon: @image-url("icons/database.svg");
            expanded <=> DataState.backup-open;
            CheckBox { font-size: 13px; text: "包含快照图片"; checked <=> DataState.snapshots; enabled: !DataState.busy; }
            LineEdit {
                height: 34px;
                text <=> DataState.password;
                input-type: password;
                placeholder-text: "独立密码（留空则不加密）";
                enabled: !DataState.busy;
            }
            if DataState.password != "" : LineEdit {
                height: 34px;
                text <=> DataState.password-again;
                input-type: password;
                placeholder-text: "再次输入密码";
                enabled: !DataState.busy;
            }
            if DataState.password != "" && DataState.password-again != "" && DataState.password != DataState.password-again : Note {
                text: "两次输入的密码不一致。"; color: Theme.danger; font-size: 12px;
            }
            Note {
                text: DataState.password != "" ? "独立密码无法找回，也不会保存在备份内；忘记密码后这份备份无法打开。" : "不设密码时，任何拿到 ZIP 的人都能读取其中的记录。";
                font-size: 12px;
            }
            if DataState.password == "" : CheckBox { font-size: 13px; text: "我知道这份备份未加密、含敏感数据，并会妥善保管"; checked <=> DataState.sensitive-confirmed; enabled: !DataState.busy; }
            HorizontalLayout {
                Action {
                    text: DataState.busy ? "正在处理…" : "创建备份…";
                    icon: @image-url("icons/download.svg");
                    accent: true;
                    enabled: !DataState.busy && (DataState.password != "" ? DataState.password == DataState.password-again : DataState.sensitive-confirmed);
                    clicked => { DataState.action(2); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Rule { }
        SettingExpander {
            title: "从备份恢复";
            description: "用一份便携备份替换当前的全部记录。恢复前会先校验备份。";
            icon: @image-url("icons/history.svg");
            expanded: DataState.recovery-needed;
            if DataState.recovery-needed : Note { text: "当前处于恢复模式。选择一个备份，校验通过后再替换数据集。"; color: Theme.brand-ink; }
            LineEdit {
                height: 34px;
                text <=> DataState.restore-password;
                input-type: password;
                placeholder-text: "备份密码（没有则留空）";
                enabled: !DataState.busy;
                edited => { DataState.restore-ready = false; DataState.restore-info = ""; }
            }
            HorizontalLayout {
                spacing: 10px;
                Action {
                    text: DataState.archive == "" ? "选择备份…" : "换一个备份…";
                    icon: @image-url("icons/folder.svg");
                    enabled: !DataState.busy;
                    clicked => { DataState.action(1); }
                }
                if DataState.archive != "" && !DataState.restore-ready : Action { text: "重新校验"; enabled: !DataState.busy; clicked => { DataState.action(3); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if DataState.restore-info != "" : Note { text: DataState.restore-info; color: DataState.restore-ready ? Theme.ink-2 : Theme.danger; }
            Note { text: "恢复会整体替换现有记录，不会合并。"; font-size: 12px; }
            HorizontalLayout {
                Action { text: "用此备份替换当前数据…"; danger: true; enabled: !DataState.busy && DataState.restore-ready; clicked => { DataState.restore-confirm = 1; } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    Rectangle { height: 10px; }
    SettingsHeader { text: "维护"; }
    SettingsGroup {
        SettingRow {
            title: "完整性检查";
            description: DataState.integrity != "" ? DataState.integrity : "检查数据库的完整性与外键。";
            icon: @image-url("icons/shield.svg");
            Action { text: "运行检查"; enabled: !DataState.busy; clicked => { DataState.action(8); } }
        }
        Rule { }
        SettingRow {
            title: "修复工具";
            description: "数据损坏时使用：Timelens 会退出并打开修复工具，从备份或可读取的记录重建数据。";
            icon: @image-url("icons/refresh.svg");
            Action { text: "打开修复工具…"; enabled: !DataState.busy; clicked => { DataState.restore-confirm = 2; } }
        }
    }
}

// Moving the data: a progress sheet that blocks the window while files copy,
// then the outcome, with the reason when it failed.
export component MoveDialog inherits Rectangle {
    callback closed;
    private property <bool> moving: DataState.move-phase == 1;
    private property <bool> failed: DataState.move-phase == 3;
    background: Theme.scrim;
    TouchArea { }
    move-keys := FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        // Not in `init`; see ConfirmationDialog in theme.slint.
        Timer { interval: 1ms; triggered => { move-keys.focus(); self.running = false; } }
        key-pressed(event) => {
            if !root.moving && (event.text == Key.Escape || event.text == Key.Return) { root.closed(); }
            return accept;
        }
        Rectangle {
            width: min(460px, parent.width - 48px); height: sheet.preferred-height;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface; border-radius: 16px; border-width: 1px; border-color: Theme.line;
            drop-shadow-blur: 48px; drop-shadow-offset-y: 18px; drop-shadow-color: Theme.shadow-strong;
            sheet := VerticalLayout {
                padding: 26px; padding-bottom: 22px; spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 40px; height: 40px; border-radius: 12px;
                        background: root.moving ? Theme.brand-soft : root.failed ? Theme.danger-soft : Theme.ok-soft;
                        animate background { duration: 200ms; easing: ease-out; }
                        Image {
                            width: 20px; height: 20px;
                            source: root.moving ? @image-url("icons/database.svg") : root.failed ? @image-url("icons/alert-triangle.svg") : @image-url("icons/check.svg");
                            colorize: root.moving ? Theme.brand : root.failed ? Theme.danger : Theme.ok;
                        }
                    }
                    SectionTitle {
                        text: root.moving ? "正在迁移数据" : root.failed ? "迁移失败" : "迁移完成";
                        font-size: 17px; vertical-alignment: center;
                    }
                }
                if root.moving : VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: DataState.move-step; color: Theme.ink-2; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
                        Text { text: Math.round(DataState.move-progress * 100) + "%"; color: Theme.brand-ink; font-size: 13px; font-weight: 600; }
                    }
                    Rectangle {
                        height: 8px; border-radius: 4px; background: Theme.surface-2; clip: true;
                        Rectangle {
                            x: 0px; height: parent.height; border-radius: 4px; background: Theme.brand;
                            width: max(8px, parent.width * DataState.move-progress);
                            animate width { duration: 240ms; easing: ease-out; }
                        }
                    }
                    Note { text: "迁移期间暂停记录。请不要关闭 Timelens 或拔出目标磁盘，完成后会自动恢复记录。"; font-size: 12px; }
                }
                if !root.moving : Note { text: DataState.move-message; color: Theme.ink-2; font-size: 14px; }
                if !root.moving : HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Action { min-width: 96px; text: root.failed ? "知道了" : "好的"; accent: true; modal-action: true; clicked => { root.closed(); } }
                }
            }
        }
    }
}
