import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, Action, Badge, Label, Note, SectionTitle, Rule, CheckBox, StatusLine, Segmented, Segment, Switch, SettingRow, SettingsHeader, SettingsGroup, SettingExpander } from "theme.slint";

// A key's position and size are in key units on the 93-key board.
// `pulse` changes each time the key or button is pressed, which lights it.
export struct KeyCell { label: string, count: string, strength: float, pulse: int, x: float, y: float, w: float, h: float }
export struct ButtonHeat { count: string, strength: float, pulse: int }
// A system state over the range: its name, time and share of the range.
export struct SystemRow { label: string, duration: string, share: string, ratio: float }
export global CollectionState {
    in-out property <bool> open: false;
    in-out property <int> page: 0;
    in-out property <bool> busy: false;
    in-out property <bool> paused: false;
    // When a timed pause ends, in words; empty when it lasts until resumed.
    in-out property <string> resume-label;
    // Pauses recording for so many minutes; -2 until tomorrow, -1 until resumed.
    callback pause-for(int);
    in-out property <[string]> apps;
    in-out property <int> app-index: -1;
    in-out property <int> merge-index: -1;
    in-out property <[string]> links;
    in-out property <int> link-index: -1;
    in-out property <bool> activity: false;
    in-out property <bool> input: false;
    in-out property <bool> snapshots: false;
    in-out property <string> rules;
    in-out property <bool> merge-confirmed: false;
    in-out property <bool> delete-confirmed: false;
    in-out property <string> impact;
    // The chosen application's name, and the rules a merge would leave both.
    in-out property <string> app-name;
    in-out property <string> merge-preview;
    // The confirmation open over the window: 1 delete history, 2 merge, 3
    // delete one stretch of history, which `stretch` names.
    in-out property <int> confirm;
    in-out property <string> stretch;
    callback merge-chosen(int);
    // An application's right-click menu: 0 stop recording its activity, 1 ask
    // to delete its history, 2 open the rules page on it, 3 ask to delete the
    // stretch of it on screen.
    callback app-menu(string, int);
    in-out property <string> status;
    // What the key statistics cover, and whether that is only part of a day,
    // which key and mouse counts, kept per day, cannot show.
    in-out property <string> scope;
    in-out property <bool> partial-day;
    in-out property <string> totals;
    in-out property <[SystemRow]> system;
    // Instants such as a clean shutdown, by count.
    in-out property <string> system-marks;
    in-out property <[KeyCell]> keys;
    in-out property <string> unplaced-keys;
    in-out property <ButtonHeat> mouse-left;
    in-out property <ButtonHeat> mouse-middle;
    in-out property <ButtonHeat> mouse-right;
    callback opened;
    callback choose(int);
    callback action(int);
    // A finished action's result is waiting to be applied.
    callback updates-ready;
    // The tray menu and tooltip follow these three.
    callback menu-changed;
    changed busy => { menu-changed(); }
    changed paused => { menu-changed(); }
    changed resume-label => { menu-changed(); }
}

// A heat color stays readable under its label.
global Heat {
    public pure function ink(strength: float) -> color {
        if Theme.dark { return strength > 0.6 ? Theme.on-primary : Theme.ink; }
        return strength >= 0.8 ? #ffffff : strength > 0.5 ? #000000 : Theme.ink;
    }
}

// Lights up for a moment each time `pulse` goes up, then fades.
component Flash inherits Rectangle {
    in property <int> pulse;
    private property <bool> lit;
    background: Theme.warn-line;
    opacity: 0;
    changed pulse => { root.lit = true; }
    Timer { interval: 90ms; running: root.lit; triggered => { root.lit = false; } }
    states [
        lit when root.lit : {
            opacity: 0.85;
            in { animate opacity { duration: 40ms; } }
            out { animate opacity { duration: 520ms; easing: ease-out; } }
        }
    ]
}

// One mouse button: the body's outline clipped to the button's part, so each
// button keeps the rounded corners of the mouse it sits on.
component MouseButtonArea inherits Rectangle {
    in property <ButtonHeat> heat;
    in property <length> body-x;
    in property <length> body-width;
    in property <length> body-height;
    in property <length> body-radius;
    clip: true;
    Rectangle {
        x: -root.body-x; y: 0px;
        width: root.body-width; height: root.body-height;
        border-radius: root.body-radius;
        background: Theme.heat-hot.mix(Theme.heat-cold, root.heat.strength);
        animate background { duration: 300ms; easing: ease-out; }
        Flash { pulse: root.heat.pulse; border-radius: parent.border-radius; }
    }
    Text {
        y: root.height - 30px; height: 20px;
        text: root.heat.count;
        color: Heat.ink(root.heat.strength);
        font-size: 12px; font-weight: 600;
        horizontal-alignment: center;
    }
}

component MouseHeatMap inherits Rectangle {
    private property <length> body-width: 128px;
    private property <length> body-height: 200px;
    private property <length> radius: 60px;
    private property <length> button-height: 92px;
    width: root.body-width;
    height: root.body-height;
    // The palm below the buttons.
    Rectangle { border-radius: root.radius; background: Theme.surface-2; }
    MouseButtonArea {
        x: 0px; y: 0px; width: root.body-width / 2 - 1px; height: root.button-height;
        heat: CollectionState.mouse-left;
        body-x: 0px; body-width: root.body-width; body-height: root.body-height; body-radius: root.radius;
    }
    MouseButtonArea {
        x: root.body-width / 2 + 1px; y: 0px; width: root.body-width / 2 - 1px; height: root.button-height;
        heat: CollectionState.mouse-right;
        body-x: root.body-width / 2 + 1px; body-width: root.body-width; body-height: root.body-height; body-radius: root.radius;
    }
    // The wheel sits on the seam between both buttons.
    Rectangle {
        x: (root.body-width - self.width) / 2; y: 18px;
        width: 22px; height: 46px;
        border-radius: 11px;
        border-width: 2px;
        border-color: Theme.layer;
        background: Theme.heat-hot.mix(Theme.heat-cold, CollectionState.mouse-middle.strength);
        Flash { pulse: CollectionState.mouse-middle.pulse; border-radius: parent.border-radius; }
    }
    Rectangle { y: root.button-height; height: 1px; background: Theme.line; }
    Rectangle { border-radius: root.radius; border-width: 1px; border-color: Theme.outline; }
    Image {
        y: root.button-height + 40px; width: 20px; height: 20px;
        source: @image-url("icons/mouse.svg");
        colorize: Theme.ink-4;
    }
}

component MouseLegend inherits HorizontalLayout {
    in property <string> label;
    in property <ButtonHeat> heat;
    spacing: 10px;
    VerticalLayout { alignment: center; Rectangle { width: 14px; height: 14px; border-radius: 3px; border-width: 1px; border-color: Theme.line; background: Theme.heat-hot.mix(Theme.heat-cold, root.heat.strength); } }
    Text { width: 128px; text: root.label; color: Theme.ink-2; font-size: 13px; vertical-alignment: center; }
    Text { text: @tr("{} 次", root.heat.count); color: Theme.ink; font-size: 14px; font-weight: 600; font-family: Theme.font-display; vertical-alignment: center; }
}

export component CollectionPanel inherits Rectangle {
    background: Theme.paper;
    // One key unit; the 19.75-unit board scrolls sideways once it no longer fits.
    private property <length> key-unit: max(38px, min(50px, (root.width - 34px) / 19.75));

    VerticalLayout {
        spacing: 10px;

        if CollectionState.page == 0 : ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                padding-right: 18px;
                padding-bottom: 16px;
                spacing: 10px;
                SettingsHeader { text: @tr("应用"); }
                SettingsGroup {
                    SettingRow {
                        title: @tr("要设置的应用");
                        description: CollectionState.apps.length == 0 ? @tr("还没有已记录的应用，可以直接选择一个 EXE。") : @tr("从已记录的应用中选择，或指定一个 EXE。规则只影响之后的记录。");
                        icon: @image-url("icons/app-window.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                width: 220px; height: 34px;
                                model: CollectionState.apps;
                                current-index <=> CollectionState.app-index;
                                enabled: !CollectionState.busy && CollectionState.apps.length > 0;
                                selected(value) => { CollectionState.merge-confirmed = false; CollectionState.delete-confirmed = false; CollectionState.choose(CollectionState.app-index); }
                            }
                            Action { text: @tr("选择 EXE"); enabled: !CollectionState.busy; clicked => { CollectionState.action(1); } }
                        }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: @tr("排除规则"); }
                Note { text: @tr("三份名单相互独立，切换后立即生效，不影响已有记录和图片。"); font-size: 12px; }
                SettingsGroup {
                    SettingRow {
                        title: @tr("不记录活动");
                        description: @tr("不记录这个应用的身份与使用时间。");
                        icon: @image-url("icons/activity.svg");
                        Switch {
                            label: @tr("不记录活动");
                            checked: CollectionState.activity;
                            enabled: !CollectionState.busy && CollectionState.app-index >= 0;
                            toggled(on) => { CollectionState.activity = on; CollectionState.action(2); }
                        }
                    }
                    Rule { }
                    SettingRow {
                        title: @tr("不记录输入");
                        description: @tr("只保留匿名的每日总数。");
                        icon: @image-url("icons/keyboard.svg");
                        Switch {
                            label: @tr("不记录输入");
                            checked: CollectionState.input;
                            enabled: !CollectionState.busy && CollectionState.app-index >= 0;
                            toggled(on) => { CollectionState.input = on; CollectionState.action(2); }
                        }
                    }
                    Rule { }
                    SettingRow {
                        title: @tr("不拍摄快照");
                        description: @tr("这个应用显示在屏幕上时，跳过它所在的屏幕。");
                        icon: @image-url("icons/camera.svg");
                        Switch {
                            label: @tr("不拍摄快照");
                            checked: CollectionState.snapshots;
                            enabled: !CollectionState.busy && CollectionState.app-index >= 0;
                            toggled(on) => { CollectionState.snapshots = on; CollectionState.action(2); }
                        }
                    }
                    Rule { }
                    SettingExpander {
                        title: @tr("全部排除名单");
                        description: @tr("所有应用的活动、输入与快照排除。");
                        icon: @image-url("icons/file-description.svg");
                        Note { text: CollectionState.rules != "" ? CollectionState.rules : @tr("尚无排除规则。"); color: Theme.ink-2; font-size: 12px; }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: @tr("合并显示"); }
                SettingsGroup {
                    SettingExpander {
                        title: CollectionState.app-index >= 0 ? @tr("把「{}」与另一个应用合并", CollectionState.app-name) : @tr("与另一个应用合并显示");
                        description: @tr("同一款软件的不同版本可以合并成一项显示，原始记录不改写，可随时解除。");
                        icon: @image-url("icons/link.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                height: 34px; horizontal-stretch: 1;
                                model: CollectionState.apps;
                                current-index <=> CollectionState.merge-index;
                                enabled: !CollectionState.busy && CollectionState.app-index >= 0 && CollectionState.apps.length > 1;
                                selected(value) => { CollectionState.merge-chosen(CollectionState.merge-index); }
                            }
                            Action {
                                text: @tr("合并…");
                                enabled: !CollectionState.busy && CollectionState.app-index >= 0 && CollectionState.merge-index >= 0 && CollectionState.merge-index != CollectionState.app-index;
                                clicked => { CollectionState.confirm = 2; }
                            }
                        }
                        Note {
                            text: CollectionState.merge-preview != "" ? CollectionState.merge-preview : @tr("选择要合并的另一个应用，这里会列出合并后两者共用的规则。");
                            color: Theme.ink-2; font-size: 12px;
                        }
                    }
                    Rule { }
                    SettingExpander {
                        title: @tr("已有合并");
                        description: CollectionState.links.length == 0 ? @tr("当前没有合并关联。") : @tr("{n} 组合并关联" | "{n} 组合并关联" % CollectionState.links.length);
                        icon: @image-url("icons/layout-grid.svg");
                        for link[index] in CollectionState.links : HorizontalLayout {
                            spacing: 8px;
                            Text { text: link; color: Theme.ink; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Action {
                                quiet: true;
                                text: @tr("解除");
                                accessible-label: @tr("解除合并 {}", link);
                                enabled: !CollectionState.busy;
                                clicked => { CollectionState.link-index = index; CollectionState.action(4); }
                            }
                        }
                        Note { text: @tr("解除后恢复合并前的规则；合并期间新增的排除默认保留给双方。"); font-size: 12px; }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: @tr("删除历史"); color: Theme.danger; }
                SettingsGroup {
                    border-color: Theme.danger-line;
                    SettingExpander {
                        title: CollectionState.app-index >= 0 ? @tr("删除「{}」的全部历史", CollectionState.app-name) : @tr("删除所选应用的全部历史");
                        description: @tr("此操作无法撤销。");
                        icon: @image-url("icons/trash.svg");
                        Note { text: CollectionState.impact != "" ? CollectionState.impact : @tr("先在上方选择一个应用，这里会显示受影响的窗口。"); color: Theme.ink-2; }
                        Note { text: @tr("匿名累计总数和无法归属应用的每日键位总数会保留，快照图片与外部文件也会保留。"); font-size: 12px; }
                        HorizontalLayout {
                            Action {
                                text: CollectionState.app-index >= 0 ? @tr("删除「{}」的历史…", CollectionState.app-name) : @tr("删除历史…");
                                danger: true;
                                enabled: !CollectionState.busy && CollectionState.app-index >= 0;
                                clicked => { CollectionState.confirm = 1; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }

        if CollectionState.page == 1 : ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                padding-right: 16px;
                padding-bottom: 12px;
                spacing: 16px;
                HorizontalLayout {
                    spacing: 10px;
                    SectionTitle { text: @tr("物理键位热度"); vertical-alignment: center; }
                    VerticalLayout { alignment: center; Badge { text: CollectionState.scope; tone: Theme.brand-ink; fill: Theme.brand-soft; } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Note { text: CollectionState.partial-day ? @tr("按键抬起后再次按下计为一次。键帽标记物理位置，不代表输入内容。键位与鼠标按整天保存，这里显示所选时段所在日期的全天数据。") : @tr("按键抬起后再次按下计为一次。键帽标记物理位置，不代表输入内容。"); }
                keyboard-scroll := ScrollView {
                    height: root.key-unit * 6.5 + 14px;
                    vertical-stretch: 0;
                    viewport-width: max(root.key-unit * 19.75, self.visible-width);
                    viewport-height: root.key-unit * 6.5;
                    horizontal-scrollbar-policy: as-needed;
                    vertical-scrollbar-policy: always-off;
                    Rectangle {
                        width: keyboard-scroll.viewport-width;
                        height: root.key-unit * 6.5;
                        for key in CollectionState.keys : Rectangle {
                            x: key.x * root.key-unit;
                            y: key.y * root.key-unit;
                            width: key.w * root.key-unit - 4px;
                            height: key.h * root.key-unit - 4px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: key.strength > 0 ? Theme.heat-line : Theme.line;
                            // Slint mix() applies the factor to its receiver: zero stays paper-gray.
                            background: Theme.heat-hot.mix(Theme.heat-cold, key.strength);
                            animate background { duration: 300ms; easing: ease-out; }
                            Flash { pulse: key.pulse; border-radius: 5px; }
                            VerticalLayout {
                                padding: 3px;
                                spacing: 1px;
                                alignment: center;
                                Text { text: key.label; color: Heat.ink(key.strength); font-size: 11px; horizontal-alignment: center; overflow: elide; }
                                Text { text: key.count; color: Heat.ink(key.strength); font-size: 10px; horizontal-alignment: center; overflow: elide; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Note { text: @tr("少"); }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: Theme.heat-cold; }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: Theme.heat-hot.mix(Theme.heat-cold, 0.25); }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: Theme.heat-hot.mix(Theme.heat-cold, 0.5); }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: Theme.heat-hot.mix(Theme.heat-cold, 0.75); }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: Theme.heat-hot; }
                    Note { text: @tr("多"); }
                    Rectangle { horizontal-stretch: 1; }
                }
                if CollectionState.unplaced-keys != "" : Note { text: CollectionState.unplaced-keys; font-size: 12px; }
                Rule { }
                SectionTitle { text: @tr("鼠标按键热度"); }
                Note { text: @tr("鼠标左键、中键和右键的按下次数，范围与颜色都与上方键位相同。"); }
                HorizontalLayout {
                    spacing: 32px;
                    padding-left: 8px;
                    MouseHeatMap { }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        spacing: 10px;
                        MouseLegend { label: @tr("左键"); heat: CollectionState.mouse-left; }
                        MouseLegend { label: @tr("中键（滚轮按下）"); heat: CollectionState.mouse-middle; }
                        MouseLegend { label: @tr("右键"); heat: CollectionState.mouse-right; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rule { }
                SectionTitle { text: @tr("系统状态"); }
                Note { text: @tr("空闲、锁屏、睡眠等系统状态在所选范围内的时长，按时长排列。"); }
                if CollectionState.system.length == 0 && CollectionState.system-marks == "" : Note { text: @tr("此范围没有系统状态记录。"); color: Theme.ink; }
                VerticalLayout {
                    spacing: 8px;
                    for row in CollectionState.system : HorizontalLayout {
                        spacing: 12px;
                        Text { width: 96px; text: row.label; color: Theme.ink; font-size: 13px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Rectangle {
                                height: 6px; border-radius: 3px; background: Theme.track;
                                Rectangle { x: 0px; width: max(2px, parent.width * row.ratio); border-radius: 3px; background: Theme.brand; }
                            }
                        }
                        Text { width: 90px; text: row.duration; color: Theme.ink; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 48px; text: row.share; color: Theme.ink-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
                if CollectionState.system-marks != "" : Note { text: CollectionState.system-marks; font-size: 12px; }
                Rule { }
                SectionTitle { text: @tr("自开始使用以来"); }
                Note { text: CollectionState.totals; color: Theme.ink; }
                Note { text: @tr("这里的累计不受保留期清理影响，也包含不记录输入的应用的匿名计数，所以可能比上方按范围统计的次数多。"); font-size: 12px; }
            }
        }

        if CollectionState.busy : StatusLine { busy: true; text: @tr("正在处理，请稍候…"); }
    }
}
