import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Action, Label, Note, SectionTitle, Rule, CheckBox, StatusLine, Segmented, Segment, Switch, SettingRow, SettingsHeader, SettingsGroup, SettingExpander } from "theme.slint";

export struct KeyCell { label: string, count: string, strength: float, col: float, row: float, units: float }
export global CollectionState {
    in-out property <bool> open: false;
    in-out property <int> page: 0;
    in-out property <bool> busy: false;
    in-out property <bool> paused: false;
    in-out property <[string]> apps;
    in-out property <int> app-index: -1;
    in-out property <int> merge-index: -1;
    in-out property <[string]> links;
    in-out property <int> link-index: -1;
    in-out property <bool> activity: false;
    in-out property <bool> input: false;
    in-out property <bool> snapshots: false;
    in-out property <string> rules;
    in-out property <bool> merge-confirmed: false;
    in-out property <bool> delete-confirmed: false;
    in-out property <string> impact;
    in-out property <string> status;
    in-out property <string> date;
    in-out property <string> totals;
    in-out property <string> system;
    in-out property <[KeyCell]> keys;
    callback opened;
    callback choose(int);
    callback action(int);
}

export component CollectionPanel inherits Rectangle {
    background: Theme.paper;

    VerticalLayout {
        spacing: 10px;

        if CollectionState.page == 0 : ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                padding-right: 18px;
                padding-bottom: 16px;
                spacing: 10px;
                SettingsHeader { text: "应用"; }
                SettingsGroup {
                    SettingRow {
                        title: "要设置的应用";
                        description: CollectionState.apps.length == 0 ? "还没有已记录的应用，可以直接选择一个 EXE。" : "从已记录的应用中选择，或指定一个 EXE。规则只影响之后的记录。";
                        icon: @image-url("icons/app-window.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                width: 220px; height: 34px;
                                model: CollectionState.apps;
                                current-index <=> CollectionState.app-index;
                                enabled: !CollectionState.busy && CollectionState.apps.length > 0;
                                selected(value) => { CollectionState.merge-confirmed = false; CollectionState.delete-confirmed = false; CollectionState.choose(CollectionState.app-index); }
                            }
                            Action { text: "选择 EXE"; enabled: !CollectionState.busy; clicked => { CollectionState.action(1); } }
                        }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: "排除规则"; }
                Note { text: "三份名单相互独立，切换后立即生效；既有历史和图片保留。"; font-size: 12px; }
                SettingsGroup {
                    SettingRow {
                        title: "不记录活动";
                        description: "不记录这个应用的身份与使用时间。";
                        icon: @image-url("icons/activity.svg");
                        Switch {
                            label: "不记录活动";
                            checked: CollectionState.activity;
                            enabled: !CollectionState.busy && CollectionState.app-index >= 0;
                            toggled(on) => { CollectionState.activity = on; CollectionState.action(2); }
                        }
                    }
                    Rule { }
                    SettingRow {
                        title: "不记录输入";
                        description: "只保留匿名的每日总数。";
                        icon: @image-url("icons/keyboard.svg");
                        Switch {
                            label: "不记录输入";
                            checked: CollectionState.input;
                            enabled: !CollectionState.busy && CollectionState.app-index >= 0;
                            toggled(on) => { CollectionState.input = on; CollectionState.action(2); }
                        }
                    }
                    Rule { }
                    SettingRow {
                        title: "不拍摄快照";
                        description: "这个应用显示在屏幕上时，跳过它所在的屏幕。";
                        icon: @image-url("icons/camera.svg");
                        Switch {
                            label: "不拍摄快照";
                            checked: CollectionState.snapshots;
                            enabled: !CollectionState.busy && CollectionState.app-index >= 0;
                            toggled(on) => { CollectionState.snapshots = on; CollectionState.action(2); }
                        }
                    }
                    Rule { }
                    SettingExpander {
                        title: "全部排除名单";
                        description: "所有应用的活动、输入与截图排除。";
                        icon: @image-url("icons/file-description.svg");
                        Note { text: CollectionState.rules != "" ? CollectionState.rules : "尚无排除规则。"; color: Theme.ink-2; font-size: 12px; }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: "合并显示"; }
                SettingsGroup {
                    SettingExpander {
                        title: "与另一个应用合并显示";
                        description: "同一款软件的不同版本可以合并成一项显示，原始记录不改写。";
                        icon: @image-url("icons/link.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                height: 34px; horizontal-stretch: 1;
                                model: CollectionState.apps;
                                current-index <=> CollectionState.merge-index;
                                enabled: !CollectionState.busy && CollectionState.apps.length > 1;
                                selected(value) => { CollectionState.merge-confirmed = false; }
                            }
                            Action {
                                text: "建立合并";
                                enabled: !CollectionState.busy && CollectionState.app-index >= 0 && CollectionState.merge-index >= 0 && CollectionState.merge-index != CollectionState.app-index && CollectionState.merge-confirmed;
                                clicked => { CollectionState.action(3); }
                            }
                        }
                        CheckBox {
                            font-size: 13px;
                            text: "确认两个应用的三份排除名单各自取并集";
                            checked <=> CollectionState.merge-confirmed;
                            enabled: !CollectionState.busy && CollectionState.app-index >= 0 && CollectionState.merge-index >= 0 && CollectionState.merge-index != CollectionState.app-index;
                        }
                    }
                    Rule { }
                    SettingExpander {
                        title: "已有合并";
                        description: CollectionState.links.length == 0 ? "当前没有合并关联。" : CollectionState.links.length + " 组合并关联";
                        icon: @image-url("icons/layout-grid.svg");
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox { height: 34px; horizontal-stretch: 1; model: CollectionState.links; current-index <=> CollectionState.link-index; enabled: !CollectionState.busy && CollectionState.links.length > 0; }
                            Action { text: "解除合并"; enabled: !CollectionState.busy && CollectionState.link-index >= 0 && CollectionState.link-index < CollectionState.links.length; clicked => { CollectionState.action(4); } }
                        }
                        Note { text: "解除后恢复合并前的规则；合并期间新增的排除默认保留给双方。"; font-size: 12px; }
                    }
                }

                Rectangle { height: 8px; }
                SettingsHeader { text: "删除历史"; color: Theme.danger; }
                SettingsGroup {
                    border-color: #c8352f2e;
                    SettingExpander {
                        title: "删除所选应用的全部历史";
                        description: "同时删除引用它的本地报告、AI 总结和对话。此操作无法撤销。";
                        icon: @image-url("icons/trash.svg");
                        Note { text: CollectionState.impact != "" ? CollectionState.impact : "先在上方选择一个应用，这里会显示受影响的窗口、报告与 AI 任务。"; color: Theme.ink-2; }
                        Note { text: "匿名累计总数和无法归属应用的每日键位总数会保留，快照图片与外部文件也会保留。"; font-size: 12px; }
                        CheckBox { font-size: 13px; text: "确认删除这个应用的历史及关联内容"; checked <=> CollectionState.delete-confirmed; enabled: !CollectionState.busy && CollectionState.app-index >= 0; }
                        HorizontalLayout {
                            Action { text: "删除历史"; danger: true; enabled: !CollectionState.busy && CollectionState.app-index >= 0 && CollectionState.delete-confirmed; clicked => { CollectionState.action(5); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }

        if CollectionState.page == 1 : ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                padding-right: 16px;
                padding-bottom: 12px;
                spacing: 16px;
                Note { text: CollectionState.totals != "" ? CollectionState.totals : "选择日期，查看当天的物理键位统计。"; color: Theme.ink; }
                Rule { }
                HorizontalLayout {
                    spacing: 10px;
                    LineEdit { width: 192px; height: 36px; text <=> CollectionState.date; placeholder-text: "YYYY-MM-DD"; enabled: !CollectionState.busy; }
                    Action { width: 140px; text: "查看当天键位"; enabled: !CollectionState.busy && CollectionState.date != ""; clicked => { CollectionState.action(7); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                SectionTitle { text: "物理键位热度"; }
                Note { text: "按键抬起后再次按下计为一次。键帽标记物理位置，不代表输入内容。"; }
                keyboard-scroll := ScrollView {
                    height: 268px;
                    vertical-stretch: 0;
                    viewport-width: max(704px, self.visible-width);
                    viewport-height: 250px;
                    horizontal-scrollbar-policy: as-needed;
                    vertical-scrollbar-policy: always-off;
                    Rectangle {
                        width: keyboard-scroll.viewport-width;
                        height: 250px;
                        for key in CollectionState.keys : Rectangle {
                            x: key.col * parent.width / 16;
                            y: key.row * 50px;
                            width: key.units * parent.width / 16 - 4px;
                            height: 46px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: key.strength > 0 ? #b6baf0 : Theme.line;
                            // Slint mix() applies the factor to its receiver: zero stays paper-gray.
                            background: #4a50c8.mix(#eceef3, key.strength);
                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;
                                Text { text: key.label; color: key.strength >= 0.8 ? #ffffff : key.strength > 0.5 ? #000000 : Theme.ink; font-size: 11px; horizontal-alignment: center; }
                                Text { text: key.count; color: key.strength >= 0.8 ? #ffffff : key.strength > 0.5 ? #000000 : Theme.ink; font-size: 10px; horizontal-alignment: center; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Note { text: "少"; }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: #eceef3; }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: #4a50c8.mix(#eceef3, 0.25); }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: #4a50c8.mix(#eceef3, 0.5); }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: #4a50c8.mix(#eceef3, 0.75); }
                    Rectangle { width: 22px; height: 12px; border-radius: 2px; background: #4a50c8; }
                    Note { text: "多"; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rule { }
                SectionTitle { text: "所选范围的系统状态"; font-size: 18px; }
                Note { text: "以下统计沿用时间线所选范围，键位热图按上方本地日期统计。"; }
                Note { text: CollectionState.system != "" ? CollectionState.system : "此范围暂无系统状态记录。"; color: Theme.ink; }
            }
        }

        StatusLine { busy: CollectionState.busy; text: CollectionState.busy ? "正在处理，请稍候…" : CollectionState.status != "" ? CollectionState.status : "采集规则与统计保存在本机。"; }
    }
}
