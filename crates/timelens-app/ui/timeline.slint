// The home history: rows of a continuous, chat-history-like timeline, the card
// stack of applications used together, and the detail pane's accordion items.
import { Theme, AppIcon } from "theme.slint";
import { HistoryItem, ShareSlice, StackApp, Participant } from "models.slint";

// Shared horizontal grid of history rows.
global HistoryGrid {
    out property <length> time-x: 10px;
    out property <length> rail-x: 66px;
    out property <length> stack-x: 90px;
    out property <length> text-x: 144px;
}

component MiniShares inherits Rectangle {
    in property <[ShareSlice]> shares;
    width: 120px; height: 6px;
    border-radius: 3px;
    background: Theme.surface-3;
    clip: true;
    HorizontalLayout {
        spacing: 1px;
        for share in root.shares : Rectangle { horizontal-stretch: share.ratio; min-width: 0px; background: share.tint; }
    }
}

// A day's header: name, date and how the day went. Used in the list and pinned.
export component DayHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> duration;
    in property <string> apps;
    in property <[ShareSlice]> shares;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        Text { text: root.title; color: Theme.ink; font-size: 16px; font-weight: 700; vertical-alignment: center; }
        Text { text: root.subtitle; color: Theme.ink-3; font-size: 12px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.duration; color: Theme.ink-2; font-size: 12px; vertical-alignment: center; }
        Text { text: root.apps; color: Theme.ink-3; font-size: 12px; vertical-alignment: center; }
        VerticalLayout { alignment: center; MiniShares { shares: root.shares; } }
    }
}

// The pinned copy of the current day's header while its rows scroll by.
export component StickyDay inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> duration;
    in property <string> apps;
    in property <[ShareSlice]> shares;
    height: 60px;
    background: Theme.layer;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #161c2d10;
    DayHeader { title: root.title; subtitle: root.subtitle; duration: root.duration; apps: root.apps; shares: root.shares; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// The row's own application on top, applications used alongside stacked
// beneath like cards. Hovering fans them out with their names.
component AppStack inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    in property <string> name;
    in property <[StackApp]> stack;
    in property <int> more;
    out property <bool> expanded: hover.has-hover && root.stack.length > 0;
    callback clicked;
    width: 44px; height: 44px;

    // Cards beneath, drawn first so the main card covers them.
    for app[index] in root.stack : Rectangle {
        x: 7px + (index + 1) * 5px;
        y: 7px + (index + 1) * 4px;
        width: 30px - index * 2px; height: self.width;
        border-radius: 9px;
        background: Theme.surface;
        border-width: 1px; border-color: Theme.line-strong;
        drop-shadow-blur: 3px; drop-shadow-color: #161c2d1a;
        opacity: root.expanded ? 0 : 1;
        animate opacity { duration: 120ms; }
        AppIcon { size: parent.width - 8px; icon: app.icon; tint: app.tint; }
    }
    Rectangle {
        x: 2px; y: 3px; width: 34px; height: 34px;
        border-radius: 10px;
        background: root.stack.length > 0 ? Theme.surface : transparent;
        border-width: root.stack.length > 0 ? 1px : 0px;
        border-color: Theme.line;
        drop-shadow-blur: root.stack.length > 0 ? 4px : 0px;
        drop-shadow-color: #161c2d1f;
        opacity: root.expanded ? 0 : 1;
        animate opacity { duration: 120ms; }
        AppIcon { size: root.stack.length > 0 ? 28px : 32px; icon: root.icon; tint: root.tint; }
    }

    // The fanned-out stack, growing from the collapsed one.
    if root.stack.length > 0 : Rectangle {
        x: -4px; y: -3px;
        width: root.expanded ? fan.preferred-width : 44px;
        height: 50px;
        border-radius: 14px;
        background: Theme.surface;
        border-width: 1px; border-color: Theme.line;
        drop-shadow-blur: 18px; drop-shadow-offset-y: 6px; drop-shadow-color: #161c2d2e;
        opacity: root.expanded ? 1 : 0;
        clip: true;
        animate width { duration: 200ms; easing: ease-out; }
        animate opacity { duration: 140ms; }
        fan := HorizontalLayout {
            x: 0px;
            padding-left: 8px; padding-right: 12px; spacing: 12px;
            HorizontalLayout {
                spacing: 7px;
                VerticalLayout { alignment: center; AppIcon { size: 28px; icon: root.icon; tint: root.tint; } }
                VerticalLayout {
                    alignment: center; spacing: 0px;
                    Text { text: root.name; color: Theme.ink; font-size: 12px; font-weight: 600; }
                    Text { text: "主应用"; color: Theme.ink-3; font-size: 10px; }
                }
            }
            for app in root.stack : HorizontalLayout {
                spacing: 7px;
                VerticalLayout { alignment: center; AppIcon { size: 24px; icon: app.icon; tint: app.tint; } }
                Text { text: app.name; color: Theme.ink-2; font-size: 12px; vertical-alignment: center; }
            }
            if root.more > 0 : Text { text: "+" + root.more; color: Theme.ink-3; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        }
    }
    hover := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component HistoryRow inherits Rectangle {
    in property <HistoryItem> item;
    in property <bool> selected;
    callback select;
    // 0 show its snapshots, 1 summarize it, 2 open its application's rules.
    callback act(int);
    height: item.height;
    private property <bool> entry: item.kind == 2;
    forward-focus: key;

    if item.kind == 0 : DayHeader {
        y: 8px; height: parent.height - 8px;
        title: item.title; subtitle: item.subtitle; duration: item.duration; apps: item.time; shares: item.shares;
    }
    // The top of the history: more to load, or nothing earlier.
    if item.kind == 5 && item.more == 0 : Text {
        text: item.title; color: Theme.ink-4; font-size: 12px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if item.kind == 5 && item.more > 0 : Rectangle {
        width: earlier.preferred-width + 28px; height: 30px;
        border-radius: 15px;
        background: earlier-touch.has-hover ? Theme.hover-tint : transparent;
        border-width: 1px; border-color: Theme.line;
        animate background { duration: 140ms; }
        accessible-role: button;
        accessible-label: item.title;
        accessible-action-default => { root.select(); }
        earlier := Text { text: item.title; color: Theme.ink-2; font-size: 12px; vertical-alignment: center; }
        earlier-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select(); } }
    }
    if item.kind == 1 : Text {
        x: HistoryGrid.text-x; y: 12px;
        text: item.title; color: Theme.ink-4; font-size: 12px; font-weight: 600;
    }

    // The rail joins neighbouring rows of the same stretch; it is dashed
    // where nothing was recorded.
    if item.kind >= 2 && item.kind != 4 : Rectangle {
        x: HistoryGrid.rail-x - 1px; width: 2px;
        y: item.rail-top ? 0px : parent.height / 2;
        height: (item.rail-top ? parent.height / 2 : 0px) + (item.rail-bottom ? parent.height / 2 : 0px);
        background: Theme.line;
    }
    if item.kind == 4 : Rectangle {
        for dash in 6 : Rectangle {
            x: HistoryGrid.rail-x - 1px; width: 2px;
            y: dash * 6px; height: 3px;
            background: Theme.line-strong;
        }
    }

    if item.kind == 3 || item.kind == 4 : Rectangle {
        Rectangle {
            x: HistoryGrid.rail-x - 4px; width: 8px; height: 8px; border-radius: 4px;
            background: Theme.layer;
            border-width: 1.5px;
            border-color: Theme.ink-4;
        }
        if item.kind == 4 : Text { x: HistoryGrid.time-x; text: item.time; color: Theme.ink-4; font-family: Theme.font-display; font-size: 12px; vertical-alignment: center; }
        Text {
            x: HistoryGrid.text-x; width: parent.width - self.x - 10px;
            text: item.title;
            color: Theme.ink-3;
            font-size: 12px; vertical-alignment: center; overflow: elide;
        }
    }

    if root.entry : Rectangle {
        accessible-role: button;
        accessible-label: item.time + " " + item.title + "，" + item.duration + (item.subtitle == "" ? "" : "，" + item.subtitle);
        accessible-action-default => { root.select(); }
        border-radius: 12px;
        background: root.selected ? Theme.surface : touch.has-hover || stack.expanded ? Theme.hover-tint : transparent;
        border-width: key.has-focus ? 2px : root.selected ? 1px : 0px;
        border-color: key.has-focus ? Theme.focus : Theme.line;
        drop-shadow-blur: root.selected ? 12px : 0px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #161c2d14;
        animate background, drop-shadow-blur { duration: 140ms; easing: ease-out; }

        touch := TouchArea { mouse-cursor: pointer; clicked => { key.focus(); root.select(); } }

        Text {
            x: HistoryGrid.time-x; width: 48px;
            text: item.time;
            color: root.selected ? Theme.ink : Theme.ink-3;
            font-family: Theme.font-display; font-size: 12.5px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
        Rectangle {
            x: HistoryGrid.rail-x - 6px; width: 12px; height: 12px; border-radius: 6px;
            background: item.tint;
            border-width: 2.5px;
            border-color: root.selected ? Theme.surface : Theme.layer;
            drop-shadow-blur: root.selected ? 6px : 0px;
            drop-shadow-color: item.tint.with-alpha(0.55);
        }
        VerticalLayout {
            x: HistoryGrid.text-x;
            width: parent.width - self.x - 130px;
            alignment: center; spacing: 3px;
            Text { text: item.title; color: Theme.ink; font-size: 14px; font-weight: root.selected ? 600 : 500; overflow: elide; }
            if item.subtitle != "" : Text { text: item.subtitle; color: Theme.ink-3; font-size: 12px; overflow: elide; }
        }
        Text {
            x: parent.width - 126px; width: 84px;
            text: item.duration;
            color: Theme.ink-2; font-size: 13px; font-weight: 500;
            horizontal-alignment: right; vertical-alignment: center;
        }
        more := Rectangle {
            x: parent.width - 36px; width: 28px; height: 28px;
            border-radius: 8px;
            background: more-touch.has-hover ? Theme.press : transparent;
            opacity: touch.has-hover || more-touch.has-hover || root.selected ? 1 : 0;
            animate opacity { duration: 120ms; }
            Image { width: 16px; height: 16px; source: @image-url("icons/dots.svg"); colorize: Theme.ink-3; }
            more-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select(); menu.show(); } }
        }
        menu := PopupWindow {
            x: parent.width - 196px; y: parent.height - 4px;
            width: 190px;
            Rectangle {
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px; border-color: Theme.line;
                drop-shadow-blur: 22px; drop-shadow-offset-y: 8px; drop-shadow-color: #161c2d33;
                VerticalLayout {
                    padding: 5px;
                    for label[index] in ["查看这段的快照", "为这段生成总结", "这个应用的规则"] : Rectangle {
                        height: 32px; border-radius: 7px;
                        background: option.has-hover ? Theme.surface-2 : transparent;
                        Text { x: 10px; text: label; color: Theme.ink; font-size: 13px; vertical-alignment: center; }
                        option := TouchArea { mouse-cursor: pointer; clicked => { root.act(index); } }
                    }
                }
            }
        }
        stack := AppStack {
            x: HistoryGrid.stack-x; y: (parent.height - self.height) / 2;
            icon: item.icon; tint: item.tint; name: item.title;
            stack: item.stack; more: item.more;
            clicked => { key.focus(); root.select(); }
        }
    }
    key := FocusScope {
        width: 0px;
        enabled: root.entry;
        key-pressed(event) => { if event.text == " " || event.text == "\n" { root.select(); return accept; } return reject; }
    }
}

// Where within an activity an application was focused, shown or behind, and
// for how long.
export component AppTimes inherits VerticalLayout {
    in property <Participant> app;
    spacing: 10px;
    Rectangle {
        height: 14px; border-radius: 4px; background: Theme.surface-2; clip: true;
        for segment in root.app.segments : Rectangle {
            x: segment.offset * parent.width; width: max(1px, segment.width * parent.width);
            y: segment.kind == 2 ? 0px : segment.kind == 1 ? 3px : 6px;
            height: segment.kind == 2 ? parent.height : segment.kind == 1 ? 8px : 2px;
            background: segment.kind == 2 ? root.app.tint : segment.kind == 1 ? root.app.tint.with-alpha(0.35) : Theme.ink-4;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        for metric in [
            { label: "聚焦", value: root.app.focused, swatch: 2 },
            { label: "前台可见", value: root.app.visible, swatch: 1 },
            { label: "后台", value: root.app.background, swatch: 0 },
        ] : Rectangle {
            horizontal-stretch: 1;
            height: 54px;
            border-radius: 8px;
            background: Theme.surface-2;
            VerticalLayout {
                padding: 8px; spacing: 2px;
                HorizontalLayout {
                    spacing: 5px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px; height: metric.swatch == 0 ? 2px : 8px; border-radius: 2px;
                            background: metric.swatch == 2 ? root.app.tint : metric.swatch == 1 ? root.app.tint.with-alpha(0.35) : Theme.ink-4;
                        }
                    }
                    Text { text: metric.label; color: Theme.ink-3; font-size: 11px; }
                }
                Text { text: metric.value; color: Theme.ink; font-size: 13px; font-weight: 600; font-family: Theme.font-display; }
            }
        }
    }
}

// One application in the detail pane; opens to its times within the activity.
export component ParticipantItem inherits Rectangle {
    in property <Participant> app;
    in-out property <bool> expanded: false;
    height: header.height + (root.expanded ? body.preferred-height : 0px);
    clip: true;
    animate height { duration: 200ms; easing: ease-out; }
    border-radius: 10px;
    background: root.expanded ? Theme.surface : head-touch.has-hover ? Theme.hover-tint : transparent;
    border-width: root.expanded ? 1px : 0px;
    border-color: Theme.line;
    animate background { duration: 140ms; }
    accessible-role: button;
    accessible-label: root.app.name + "，" + root.app.role + "，聚焦 " + root.app.focused;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.expanded = !root.expanded; }

    header := Rectangle {
        y: 0px; height: 46px;
        HorizontalLayout {
            padding-left: 8px; padding-right: 10px; spacing: 10px;
            VerticalLayout { alignment: center; AppIcon { size: 26px; icon: root.app.icon; tint: root.app.tint; } }
            VerticalLayout {
                alignment: center; spacing: 1px; horizontal-stretch: 1;
                Text { text: root.app.name; color: Theme.ink; font-size: 13px; font-weight: 500; overflow: elide; }
                Text { text: root.app.role; color: root.app.role == "主应用" ? Theme.brand-ink : Theme.ink-3; font-size: 11px; }
            }
            Text { text: root.app.focused; color: Theme.ink-2; font-size: 12px; font-weight: 500; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Image {
                    width: 14px; height: 14px;
                    source: @image-url("icons/chevron-right.svg");
                    colorize: Theme.ink-3;
                    transform-rotation: root.expanded ? 90deg : 0deg;
                    animate transform-rotation { duration: 200ms; easing: ease-out; }
                }
            }
        }
        head-touch := TouchArea { mouse-cursor: pointer; clicked => { root.expanded = !root.expanded; } }
    }
    body := VerticalLayout {
        y: header.height;
        padding-left: 12px; padding-right: 12px; padding-bottom: 12px;
        opacity: root.expanded ? 1 : 0;
        animate opacity { duration: 180ms; }
        AppTimes { app: root.app; }
    }
}
