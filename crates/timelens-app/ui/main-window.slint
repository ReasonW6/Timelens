import { LineEdit, ListView, ScrollView, Palette } from "std-widgets.slint";
import { Theme, AppIcons, Action, NavItem, Label, Note, PageTitle, Eyebrow, Figure, Rule, DetailRow, ConfirmationDialog, CheckBox, Card, Badge, Dot, AppIcon, Segmented, Segment, Switch, SettingRow, SettingsHeader, SettingsGroup, SettingExpander, StatusLine } from "theme.slint";
import { AppRow, WindowRow, SegmentRow, SnapshotRow, ReportAppRow, HistoryItem, DayAnchor, Participant, ShareSlice, StackApp } from "models.slint";
import { HistoryRow, StickyDay, ParticipantItem, AppTimes } from "timeline.slint";
import { DataPanel, DataState, MoveDialog } from "data-panel.slint";
import { CollectionPanel, CollectionState, KeyCell, ButtonHeat, SystemRow } from "collection-panel.slint";
import { AboutPage } from "about.slint";
export { Theme, AppIcons, DataState, CollectionState, KeyCell, ButtonHeat, SystemRow, AppRow, WindowRow, SegmentRow, SnapshotRow, ReportAppRow, HistoryItem, DayAnchor, Participant, ShareSlice, StackApp }

component WindowItem inherits Rectangle {
    in property <WindowRow> item;
    private property <bool> expanded: false;
    height: root.expanded ? 96px : 36px;
    vertical-stretch: 0;
    forward-focus: key;
    accessible-role: button;
    accessible-label: root.item.label + "，聚焦 " + root.item.focused;
    accessible-action-default => { root.expanded = !root.expanded; }
    border-radius: 8px;
    border-width: key.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    background: touch.has-hover ? Theme.hover-tint : transparent;
    Image { x: 8px; y: 10px; width: 16px; height: 16px; source: @image-url("icons/app-window.svg"); colorize: Theme.ink-3; }
    Text { x: 32px; y: 0px; width: parent.width - 150px; height: 36px; text: root.item.label; color: Theme.ink; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 136px; y: 0px; width: 104px; height: 36px; text: root.item.focused; color: Theme.ink-2; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
    Image { x: parent.width - 24px; y: 10px; width: 16px; height: 16px; source: @image-url("icons/chevron-right.svg"); colorize: Theme.ink-4; transform-rotation: root.expanded ? 90deg : 0deg; animate transform-rotation { duration: 120ms; } }
    if root.expanded : Note { x: 32px; y: 38px; width: parent.width - 44px; height: 52px; text: root.item.summary; font-size: 12px; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { key.focus(); root.expanded = !root.expanded; } }
    key := FocusScope { width: 0px; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.expanded = !root.expanded; return accept; } return reject; } }
}

// A share bar: a recessed track with a tinted fill.
component ShareBar inherits Rectangle {
    in property <float> ratio;
    in property <color> tint: Theme.ink-2;
    height: 6px;
    vertical-stretch: 0;
    border-radius: 3px;
    background: Theme.surface-3;
    Rectangle { x: 0px; width: max(0, min(1, root.ratio)) * parent.width; border-radius: 3px; background: root.tint; }
}

// A compact metric: label above a figure.
component Metric inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    spacing: 4px;
    HorizontalLayout {
        spacing: 6px;
        if root.icon.width > 0 : Rectangle { width: 14px; Image { width: 14px; height: 14px; source: root.icon; colorize: Theme.ink-3; } }
        Eyebrow { text: root.label; }
    }
    Text { text: root.value; color: Theme.ink; font-family: Theme.font-display; font-size: 22px; font-weight: 600; overflow: elide; }
}

// The detail of something the user selected. It appears only on selection and
// closes with its button or Escape, so lists keep the full width otherwise.
component DetailPane inherits Rectangle {
    in property <string> title;
    callback close;
    width: 360px;
    background: Theme.pane;
    Rectangle { x: 0px; width: 1px; background: Theme.line; }
    VerticalLayout {
        HorizontalLayout {
            height: 56px;
            padding-left: 24px; padding-right: 12px; padding-top: 14px;
            Eyebrow { text: root.title; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Action { quiet: true; icon: @image-url("icons/x.svg"); accessible-label: "关闭详情"; clicked => { root.close(); } }
        }
        detail-scroll := ScrollView {
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.visible-width;
            VerticalLayout {
                width: detail-scroll.visible-width;
                alignment: start;
                padding-left: 24px; padding-right: 24px; padding-top: 4px; padding-bottom: 24px;
                spacing: 14px;
                @children
            }
        }
    }
}

// Holds a detail pane against the right edge of the content sheet. It takes no
// room from the content itself; while floating over it, a shadow sets it apart.
component DetailDrawer inherits Rectangle {
    in property <bool> floating;
    Rectangle {
        background: Theme.pane;
        drop-shadow-blur: root.floating && root.width > 0 ? 28px : 0px;
        drop-shadow-offset-x: -6px;
        drop-shadow-color: Theme.shadow-strong;
    }
    // Clicks and wheel turns on the pane must not reach the list beneath it.
    TouchArea { scroll-event(event) => { return accept; } }
    Rectangle { clip: true; @children }
}

// A snapshot in the grid: its thumbnail above its time. While selecting, a
// click ticks it and Shift extends the ticks over the span from the last one.
component SnapshotTile inherits Rectangle {
    in property <SnapshotRow> item;
    in property <bool> current;
    in property <bool> selecting;
    callback activate(bool);
    // Arrow keys and Delete, handed to the grid: 0 left, 1 right, 2 up,
    // 3 down, 4 delete.
    callback key(int);
    private property <bool> shift;
    private property <bool> clicked-focus;
    private property <bool> marked: root.selecting ? root.item.checked : root.current;
    // Nothing to tick where there is no image.
    private property <bool> inert: root.selecting && !root.item.success;
    opacity: root.inert ? 0.45 : 1;
    border-radius: 10px;
    background: root.marked ? Theme.brand-soft : touch.has-hover && !root.inert ? Theme.hover-tint : transparent;
    border-width: (key.has-focus && !root.clicked-focus) || root.marked ? 2px : 0px;
    border-color: key.has-focus && !root.clicked-focus ? Theme.focus : Theme.brand;
    forward-focus: key;
    accessible-role: button;
    accessible-checkable: root.selecting && root.item.success;
    accessible-checked: root.selecting && root.item.checked;
    accessible-label: root.item.time + "，" + root.item.display + "，" + root.item.result;
    accessible-enabled: !Theme.modal-open;
    accessible-action-default => { if !Theme.modal-open { root.activate(false); } }
    VerticalLayout {
        padding: 4px; spacing: 4px;
        Rectangle {
            height: (root.width - 8px) * 9 / 16;
            border-radius: 6px;
            background: root.item.success ? Theme.photo-bg : Theme.surface-2;
            border-width: root.item.success ? 0px : 1px;
            border-color: Theme.line-strong;
            clip: true;
            if root.item.thumb.width > 0 : Image { width: parent.width; height: parent.height; source: root.item.thumb; image-fit: cover; }
            if root.item.thumb.width == 0 && root.item.success : Image {
                width: 16px; height: 16px;
                source: @image-url("icons/photo.svg");
                colorize: #ffffff59;
            }
            // Why nothing was captured, right on the tile.
            if !root.item.success : VerticalLayout {
                alignment: center; spacing: 4px; padding: 6px;
                HorizontalLayout { alignment: center; Image { width: 14px; height: 14px; source: @image-url("icons/ban.svg"); colorize: Theme.ink-4; } }
                Text { text: root.item.note; color: Theme.ink-3; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
            }
            if root.item.badge != "" : Rectangle {
                x: parent.width - self.width - 5px; y: 5px;
                width: badge-text.preferred-width + 10px; height: 16px; border-radius: 8px;
                background: #0d111b99;
                badge-text := Text { text: root.item.badge; color: #ffffff; font-size: 10px; }
            }
            if root.selecting && root.item.success : Rectangle {
                x: 6px; y: 6px; width: 18px; height: 18px; border-radius: 9px;
                background: root.item.checked ? Theme.brand : #0d111b80;
                border-width: 1.5px; border-color: #ffffff;
                if root.item.checked : Image { width: 12px; height: 12px; source: @image-url("icons/check.svg"); colorize: #ffffff; }
            }
        }
        Text { text: root.item.time; color: root.item.success ? Theme.ink-2 : Theme.ink-4; font-size: 11px; horizontal-alignment: center; overflow: elide; }
    }
    touch := TouchArea {
        mouse-cursor: root.inert ? MouseCursor.not-allowed : MouseCursor.pointer;
        pointer-event(event) => { if event.kind == PointerEventKind.down { root.shift = event.modifiers.shift; } }
        clicked => { root.clicked-focus = true; key.focus(); if !root.inert { root.activate(root.shift); } }
    }
    key := FocusScope {
        width: 0px;
        focus-lost(reason) => { if reason != FocusReason.window-activation { root.clicked-focus = false; } }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { if !root.inert { root.activate(event.modifiers.shift); } return accept; }
            if event.text == Key.LeftArrow { root.key(0); return accept; }
            if event.text == Key.RightArrow { root.key(1); return accept; }
            if event.text == Key.UpArrow { root.key(2); return accept; }
            if event.text == Key.DownArrow { root.key(3); return accept; }
            if event.text == Key.Delete { root.key(4); return accept; }
            return reject;
        }
    }
}

// A control on the viewer's backdrop, which stays dark in both themes.
component ViewerButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback clicked;
    height: 36px;
    min-width: 36px;
    border-radius: self.height / 2;
    background: !root.enabled ? transparent : touch.pressed ? #ffffff3d : touch.has-hover ? #ffffff26 : transparent;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.text == "" ? 9px : 12px;
        padding-right: root.text == "" ? 9px : 14px;
        spacing: 6px;
        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image { width: 18px; height: 18px; source: root.icon; colorize: !root.enabled ? #ffffff47 : root.danger ? #ff9b94 : #ffffffe6; }
        }
        if root.text != "" : Text { text: root.text; color: !root.enabled ? #ffffff47 : root.danger ? #ff9b94 : #ffffffe6; font-size: 13px; vertical-alignment: center; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The snapshot viewer, which behaves like Windows Photos: it opens fitted to
// the window; the wheel zooms around the pointer, dragging pans a zoomed image,
// a double click switches between fitted and actual size, and the arrows step
// through the snapshots that have images. The backdrop does not close it.
component PhotoViewer inherits Rectangle {
    in property <image> source;
    in property <string> detail;
    in property <string> position;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <bool> can-export;
    in property <bool> can-delete;
    // Off while a dialog above has the keyboard; on again takes it back.
    in property <bool> active: true;
    callback close;
    callback step(int);
    callback export;
    callback delete;
    // The zoom the user chose; while fitted, the image follows the window.
    private property <bool> fitted: true;
    private property <float> zoom: 1;
    // The image centre's offset from the stage centre.
    private property <length> pan-x;
    private property <length> pan-y;
    private property <length> last-x;
    private property <length> last-y;
    private property <length> natural-width: root.source.width * 1phx;
    private property <length> natural-height: root.source.height * 1phx;
    private property <float> fit: min(1, min(stage.width / max(1px, root.natural-width), stage.height / max(1px, root.natural-height)));
    private property <float> scale: root.fitted ? root.fit : root.zoom;
    private property <length> shown-width: root.natural-width * root.scale;
    private property <length> shown-height: root.natural-height * root.scale;
    private property <bool> pannable: !root.fitted && (root.shown-width > stage.width || root.shown-height > stage.height);
    // How far the image may move: none while it fits, else up to its edges.
    pure function limit(offset: length, size: length, room: length) -> length {
        return size <= room ? 0px : max(-(size - room) / 2, min((size - room) / 2, offset));
    }
    // Zooms to `next` (1 shows the image's own pixels), keeping the point
    // under (x, y) on the stage where it is.
    function zoom-to(next: float, x: length, y: length) {
        let target = max(min(root.fit, 1), min(8, next));
        let ratio = target / root.scale;
        let cx = x - stage.width / 2;
        let cy = y - stage.height / 2;
        let px = root.limit(root.pan-x, root.shown-width, stage.width);
        let py = root.limit(root.pan-y, root.shown-height, stage.height);
        root.zoom = target;
        root.fitted = target <= root.fit * 1.001;
        root.pan-x = root.fitted ? 0px : root.limit(cx - (cx - px) * ratio, root.natural-width * target, stage.width);
        root.pan-y = root.fitted ? 0px : root.limit(cy - (cy - py) * ratio, root.natural-height * target, stage.height);
    }
    function fit-window() {
        root.fitted = true;
        root.pan-x = 0px;
        root.pan-y = 0px;
    }
    changed source => { root.fit-window(); }
    changed active => { if root.active { keys.focus(); } }
    background: #0b0e16;
    accessible-role: groupbox;
    accessible-label: "快照大图";

    // Clicks, drags and the wheel off the controls stay in the viewer rather
    // than reaching the page beneath it.
    TouchArea { scroll-event(event) => { return accept; } }

    keys := FocusScope {
        // Not in `init`; see ConfirmationDialog.
        Timer { interval: 1ms; triggered => { keys.focus(); self.running = false; } }
        key-pressed(event) => {
            // Tab would move focus to the page beneath the viewer.
            if event.text == Key.Tab || event.text == Key.Backtab { return accept; }
            if event.text == Key.Escape { root.close(); return accept; }
            if event.text == Key.LeftArrow { if root.can-previous { root.step(-1); } return accept; }
            if event.text == Key.RightArrow { if root.can-next { root.step(1); } return accept; }
            if event.text == "+" || event.text == "=" { root.zoom-to(root.scale * 1.25, stage.width / 2, stage.height / 2); return accept; }
            if event.text == "-" { root.zoom-to(root.scale * 0.8, stage.width / 2, stage.height / 2); return accept; }
            if event.text == "0" { root.fit-window(); return accept; }
            if event.text == "1" { root.zoom-to(1, stage.width / 2, stage.height / 2); return accept; }
            if event.text == Key.Delete && root.can-delete { root.delete(); return accept; }
            return reject;
        }

        stage := Rectangle {
            y: 56px; height: parent.height - 56px - 68px;
            clip: true;
            Image {
                x: (parent.width - self.width) / 2 + root.limit(root.pan-x, root.shown-width, parent.width);
                y: (parent.height - self.height) / 2 + root.limit(root.pan-y, root.shown-height, parent.height);
                width: root.shown-width; height: root.shown-height;
                source: root.source; image-fit: fill;
                accessible-role: image;
                accessible-label: "快照，缩放 " + Math.round(root.scale * 100) + "%";
            }
            TouchArea {
                mouse-cursor: root.pannable ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { root.last-x = self.mouse-x; root.last-y = self.mouse-y; }
                }
                moved => {
                    if self.pressed && root.pannable {
                        root.pan-x = root.limit(root.limit(root.pan-x, root.shown-width, stage.width) + self.mouse-x - root.last-x, root.shown-width, stage.width);
                        root.pan-y = root.limit(root.limit(root.pan-y, root.shown-height, stage.height) + self.mouse-y - root.last-y, root.shown-height, stage.height);
                    }
                    root.last-x = self.mouse-x;
                    root.last-y = self.mouse-y;
                }
                double-clicked => {
                    if root.fitted && root.fit < 0.999 { root.zoom-to(1, self.mouse-x, self.mouse-y); } else { root.fit-window(); }
                }
                // A wheel notch (60px) zooms by 1.2; a touchpad's small steps add up.
                scroll-event(event) => {
                    if event.delta-y != 0 { root.zoom-to(root.scale * Math.pow(1.2, event.delta-y / 60px), self.mouse-x, self.mouse-y); }
                    return accept;
                }
            }
            if root.can-previous : ViewerButton {
                x: 16px; y: (parent.height - self.height) / 2; width: 44px; height: 44px;
                background: #00000059;
                icon: @image-url("icons/chevron-left.svg"); label: "上一张";
                clicked => { root.step(-1); }
            }
            if root.can-next : ViewerButton {
                x: parent.width - self.width - 16px; y: (parent.height - self.height) / 2; width: 44px; height: 44px;
                background: #00000059;
                icon: @image-url("icons/chevron-right.svg"); label: "下一张";
                clicked => { root.step(1); }
            }
        }

        HorizontalLayout {
            y: 0px; height: 56px;
            padding-left: 24px; padding-right: 12px; spacing: 4px;
            Text { text: root.detail; color: #ffffffd9; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.position; color: #ffffff8c; font-size: 12px; vertical-alignment: center; }
            Rectangle { width: 12px; }
            VerticalLayout { alignment: center; ViewerButton { icon: @image-url("icons/download.svg"); text: "导出"; enabled: root.can-export; clicked => { root.export(); } } }
            VerticalLayout { alignment: center; ViewerButton { icon: @image-url("icons/trash.svg"); text: "删除…"; danger: true; enabled: root.can-delete; clicked => { root.delete(); } } }
            VerticalLayout { alignment: center; ViewerButton { icon: @image-url("icons/x.svg"); label: "关闭大图（Esc）"; clicked => { root.close(); } } }
        }

        // Zoom controls, like the Photos bar beneath the image.
        Rectangle {
            y: parent.height - 56px; height: 44px;
            width: zoom-bar.preferred-width; x: (parent.width - self.width) / 2;
            border-radius: 22px;
            background: #ffffff14;
            zoom-bar := HorizontalLayout {
                padding: 4px; spacing: 2px;
                ViewerButton { icon: @image-url("icons/zoom-out.svg"); label: "缩小（-）"; enabled: root.scale > min(root.fit, 1) * 1.001; clicked => { root.zoom-to(root.scale * 0.8, stage.width / 2, stage.height / 2); } }
                Text { width: 52px; text: Math.round(root.scale * 100) + "%"; color: #ffffffe6; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                ViewerButton { icon: @image-url("icons/zoom-in.svg"); label: "放大（+）"; enabled: root.scale < 7.99; clicked => { root.zoom-to(root.scale * 1.25, stage.width / 2, stage.height / 2); } }
                Rectangle { width: 1px; background: #ffffff26; }
                ViewerButton { icon: @image-url("icons/maximize.svg"); text: "适应窗口"; enabled: !root.fitted; clicked => { root.fit-window(); } }
                ViewerButton { text: "1:1"; label: "实际大小（1）"; enabled: root.fitted || root.zoom != 1; clicked => { root.zoom-to(1, stage.width / 2, stage.height / 2); } }
            }
        }
    }
}

// One entry in the picker's list of quick ranges.
component QuickRange inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: root.selected ? Theme.brand-soft : touch.has-hover ? Theme.hover-tint : transparent;
    border-width: key.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    forward-focus: key;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text { x: 12px; text: root.text; color: root.selected ? Theme.brand-ink : Theme.ink; font-size: 13px; font-weight: root.selected ? 600 : 400; vertical-alignment: center; }
    if root.selected : Image { x: parent.width - 26px; width: 14px; height: 14px; source: @image-url("icons/check.svg"); colorize: Theme.brand-ink; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    key := FocusScope { width: 0px; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
}

// A month to pick a day from. Days after today, or before the earliest the
// caller allows, are not offered.
component MonthGrid inherits VerticalLayout {
    in property <int> today-ymd;
    in property <int> earliest-ymd: 0;
    // The day shown as chosen, or 0.
    in property <int> chosen-ymd: 0;
    in-out property <int> view-y: 2026;
    in-out property <int> view-m: 1;
    callback picked(string);
    private property <[int]> month-offsets: [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    private property <int> lead: root.first-weekday(root.view-y, root.view-m);
    private property <int> days: root.month-days(root.view-y, root.view-m);
    private property <bool> can-next-month: root.view-y * 100 + root.view-m < floor(root.today-ymd / 100);
    private property <bool> can-previous-month: root.view-y * 100 + root.view-m > floor(root.earliest-ymd / 100);
    pure function two(value: int) -> string { return (value < 10 ? "0" : "") + value; }
    pure function leap(y: int) -> bool { return (Math.mod(y, 4) == 0 && Math.mod(y, 100) != 0) || Math.mod(y, 400) == 0; }
    pure function month-days(y: int, m: int) -> int {
        return m == 2 ? (root.leap(y) ? 29 : 28) : (m == 4 || m == 6 || m == 9 || m == 11) ? 30 : 31;
    }
    // The weekday of the month's first day, 0 for Monday (Sakamoto's method).
    pure function first-weekday(y: int, m: int) -> int {
        return Math.mod(root.sunday-based(m < 3 ? y - 1 : y, m) + 6, 7);
    }
    pure function sunday-based(yy: int, m: int) -> int {
        return Math.mod(yy + floor(yy / 4) - floor(yy / 100) + floor(yy / 400) + root.month-offsets[m - 1] + 1, 7);
    }
    function move-month(offset: int) {
        root.view-m += offset;
        if root.view-m < 1 { root.view-m = 12; root.view-y -= 1; }
        if root.view-m > 12 { root.view-m = 1; root.view-y += 1; }
    }
    spacing: 6px;
    HorizontalLayout {
        height: 26px;
        Text { text: root.view-y + "年" + root.view-m + "月"; color: Theme.ink; font-size: 14px; font-weight: 600; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Action { height: 26px; quiet: true; icon: @image-url("icons/chevron-left.svg"); accessible-label: "上个月"; enabled: root.can-previous-month; clicked => { root.move-month(-1); } }
        Action { height: 26px; quiet: true; icon: @image-url("icons/chevron-right.svg"); accessible-label: "下个月"; enabled: root.can-next-month; clicked => { root.move-month(1); } }
    }
    HorizontalLayout {
        for name in ["一", "二", "三", "四", "五", "六", "日"] : Text { horizontal-stretch: 1; text: name; color: Theme.ink-3; font-size: 11px; horizontal-alignment: center; }
    }
    calendar := Rectangle {
        height: 6 * 34px;
        for cell in 42 : day-cell := Rectangle {
            property <int> date: cell - root.lead + 1;
            property <int> ymd: root.view-y * 10000 + root.view-m * 100 + self.date;
            property <bool> real: self.date >= 1 && self.date <= root.days;
            property <bool> off: self.ymd > root.today-ymd || self.ymd < root.earliest-ymd;
            property <bool> chosen: root.chosen-ymd > 0 && self.ymd == root.chosen-ymd;
            x: Math.mod(cell, 7) * calendar.width / 7;
            y: floor(cell / 7) * 34px;
            width: calendar.width / 7; height: 34px;
            if day-cell.real : day-button := Rectangle {
                function pick() {
                    root.picked(root.view-y + "-" + root.two(root.view-m) + "-" + root.two(day-cell.date));
                }
                width: 30px; height: 30px; border-radius: 15px;
                background: day-cell.chosen ? Theme.primary : day-touch.has-hover && !day-cell.off ? Theme.hover-tint : transparent;
                border-width: day-key.has-focus ? 2px : day-cell.ymd == root.today-ymd && !day-cell.chosen ? 1.5px : 0px;
                border-color: day-key.has-focus ? Theme.focus : Theme.brand;
                forward-focus: day-key;
                accessible-role: button;
                accessible-label: root.view-m + "月" + day-cell.date + "日";
                accessible-enabled: !day-cell.off;
                accessible-action-default => { if !day-cell.off { day-button.pick(); } }
                Text {
                    text: day-cell.date;
                    color: day-cell.chosen ? Theme.on-primary : day-cell.off ? Theme.ink-4 : Theme.ink;
                    font-size: 13px; font-weight: day-cell.chosen ? 600 : 400;
                }
                day-touch := TouchArea {
                    enabled: !day-cell.off;
                    mouse-cursor: pointer;
                    clicked => { day-button.pick(); }
                }
                day-key := FocusScope {
                    width: 0px;
                    enabled: !day-cell.off;
                    key-pressed(event) => { if event.text == " " || event.text == "\n" { day-button.pick(); return accept; } return reject; }
                }
            }
        }
    }
}

// The range a page looks at. The arrows step a day at a time; the button opens
// a picker with quick ranges, a month calendar and part of the day. The picker
// floats over the page, so nothing beneath it moves.
component RangePicker inherits HorizontalLayout {
    in property <string> label;
    // Whether "all records" is offered, and chosen.
    in property <bool> allow-all;
    in property <bool> all;
    in property <bool> can-next;
    in property <bool> is-today;
    // Dates as yyyymmdd: today, and the day the range lies in, or 0 for a
    // recent stretch that spans several days.
    in property <int> today-ymd;
    in property <int> selected-ymd;
    in-out property <string> start: "09:00";
    in-out property <string> end: "18:00";
    callback step(int);
    callback today;
    callback choose-all;
    callback days-ago(int);
    callback horizon(int);
    callback day(string);
    callback span(string, string);
    private property <int> view-y: 2026;
    private property <int> view-m: 1;
    private property <bool> day-chosen: !root.all && root.selected-ymd > 0;
    function show-month(ymd: int) {
        root.view-y = floor(ymd / 10000);
        root.view-m = Math.mod(floor(ymd / 100), 100);
    }
    spacing: 4px;
    VerticalLayout { alignment: center; Action { quiet: true; icon: @image-url("icons/chevron-left.svg"); accessible-label: "前一天"; enabled: !root.all; clicked => { root.step(-1); } } }
    VerticalLayout {
        alignment: center;
        trigger := Action {
            text: root.label;
            icon: @image-url("icons/calendar.svg");
            accessible-label: "选择范围，当前 " + root.label;
            clicked => {
                root.show-month(root.selected-ymd > 0 ? root.selected-ymd : root.today-ymd);
                picker.show();
            }
        }
    }
    VerticalLayout { alignment: center; Action { quiet: true; icon: @image-url("icons/chevron-right.svg"); accessible-label: "后一天"; enabled: !root.all && root.can-next; clicked => { root.step(1); } } }
    VerticalLayout { alignment: center; Action { text: "今天"; enabled: root.all || !root.is-today; clicked => { root.today(); } } }

    picker := PopupWindow {
        x: root.width - self.width;
        y: root.height + 6px;
        width: 568px;
        height: sheet.preferred-height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px; border-color: Theme.line-strong;
            drop-shadow-blur: 28px; drop-shadow-offset-y: 10px; drop-shadow-color: Theme.shadow-strong;
            sheet := VerticalLayout {
                padding: 14px; spacing: 12px;
                HorizontalLayout {
                    spacing: 16px;
                    // Quick ranges.
                    VerticalLayout {
                        width: 156px; spacing: 2px; alignment: LayoutAlignment.start;
                        Eyebrow { text: "快速选择"; height: 26px; vertical-alignment: center; }
                        // Choose before closing: closing tears down this conditional row first.
                        if root.allow-all : QuickRange { text: "全部记录"; selected: root.all; clicked => { root.choose-all(); picker.close(); } }
                        QuickRange { text: "今天"; selected: !root.all && root.is-today; clicked => { picker.close(); root.today(); } }
                        QuickRange { text: "昨天"; clicked => { picker.close(); root.days-ago(1); } }
                        QuickRange { text: "最近 7 天"; clicked => { picker.close(); root.horizon(168); } }
                        QuickRange { text: "最近 30 天"; clicked => { picker.close(); root.horizon(720); } }
                    }
                    Rectangle { width: 1px; background: Theme.line; }
                    MonthGrid {
                        horizontal-stretch: 1;
                        today-ymd: root.today-ymd;
                        chosen-ymd: root.day-chosen ? root.selected-ymd : 0;
                        view-y <=> root.view-y;
                        view-m <=> root.view-m;
                        picked(date) => { picker.close(); root.day(date); }
                    }
                }
                Rule { }
                // Part of the chosen day.
                HorizontalLayout {
                    spacing: 8px;
                    Eyebrow { text: "当天时段"; vertical-alignment: center; }
                    Segmented {
                        Segment { text: "全天"; enabled: root.day-chosen; clicked => { picker.close(); root.span("00:00", "24:00"); } }
                        Segment { text: "上午"; enabled: root.day-chosen; clicked => { picker.close(); root.span("00:00", "12:00"); } }
                        Segment { text: "下午"; enabled: root.day-chosen; clicked => { picker.close(); root.span("12:00", "18:00"); } }
                        Segment { text: "晚上"; enabled: root.day-chosen; clicked => { picker.close(); root.span("18:00", "24:00"); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    LineEdit { width: 72px; height: 34px; text <=> root.start; placeholder-text: "HH:MM"; enabled: root.day-chosen; }
                    Text { text: "–"; color: Theme.ink-3; vertical-alignment: center; }
                    LineEdit { width: 72px; height: 34px; text <=> root.end; placeholder-text: "HH:MM"; enabled: root.day-chosen; accepted => { picker.close(); root.span(root.start, root.end); } }
                    Action { text: "应用"; enabled: root.day-chosen; clicked => { picker.close(); root.span(root.start, root.end); } }
                }
                if !root.day-chosen : Note { text: "先在日历中选择一天，再缩小到当天的某个时段。"; font-size: 12px; }
            }
        }
    }
}

// Jumps the history to a day picked from a month calendar. It floats over the
// list, so nothing beneath it moves.
component JumpPicker inherits Rectangle {
    in property <bool> compact;
    in property <int> today-ymd;
    in property <int> earliest-ymd;
    // The day the history shows now, where the calendar opens.
    in property <int> current-ymd;
    // Opens the calendar each time it grows, as when a day header is clicked.
    in property <int> requests;
    changed requests => { root.open(); }
    callback jump(string);
    private property <int> view-y: 2026;
    private property <int> view-m: 1;
    public function open() {
        let ymd = root.current-ymd > 0 ? root.current-ymd : root.today-ymd;
        root.view-y = floor(ymd / 10000);
        root.view-m = Math.mod(floor(ymd / 100), 100);
        popup.show();
    }
    width: trigger.min-width;
    height: 34px;
    trigger := Action {
        width: parent.width;
        text: root.compact ? "" : "跳到日期";
        icon: @image-url("icons/calendar.svg");
        accessible-label: "跳到日期";
        clicked => { root.open(); }
    }
    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 6px;
        width: 300px;
        height: jump-sheet.preferred-height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px; border-color: Theme.line-strong;
            drop-shadow-blur: 28px; drop-shadow-offset-y: 10px; drop-shadow-color: Theme.shadow-strong;
            jump-sheet := VerticalLayout {
                padding: 14px; spacing: 8px;
                MonthGrid {
                    today-ymd: root.today-ymd;
                    earliest-ymd: root.earliest-ymd;
                    chosen-ymd: root.current-ymd;
                    view-y <=> root.view-y;
                    view-m <=> root.view-m;
                    picked(date) => { popup.close(); root.jump(date); }
                }
                Note { text: "灰色的日子早于最早的记录或晚于今天。"; font-size: 12px; }
            }
        }
    }
}

// Where a page's range came from when another page set it, with a way back.
component OriginTag inherits Rectangle {
    in property <string> text;
    callback clear;
    height: 28px;
    width: tag.preferred-width;
    border-radius: 14px;
    background: Theme.brand-soft;
    border-width: 1px; border-color: Theme.brand-line;
    tag := HorizontalLayout {
        padding-left: 12px; padding-right: 4px; spacing: 4px;
        Text { text: "来自时间线：" + root.text; color: Theme.brand-ink; font-size: 12px; vertical-alignment: center; }
        Rectangle {
            width: 22px; height: 22px; y: 3px; border-radius: 11px;
            background: clear-touch.has-hover ? Theme.hover-tint : transparent;
            accessible-role: button;
            accessible-label: "恢复原来的范围";
            accessible-action-default => { root.clear(); }
            Image { width: 12px; height: 12px; source: @image-url("icons/x.svg"); colorize: Theme.brand-ink; }
            clear-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clear(); } }
        }
    }
}

// A page header: title, subtitle and actions on the right.
component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    height: 54px;
    spacing: 8px;
    VerticalLayout {
        alignment: center; spacing: 5px;
        PageTitle { text: root.title; }
        Note { text: root.subtitle; wrap: no-wrap; overflow: elide; }
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

export component AppWindow inherits Window {
    title: "Timelens";
    icon: @image-url("../assets/brand/timelens-256.png");
    preferred-width: 1440px; preferred-height: 900px;
    min-width: 960px; min-height: 600px;
    background: Theme.canvas-brush;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    // The std widgets take the same light or dark look as Theme.
    private property <bool> dark-look: Theme.dark;
    changed dark-look => { Palette.color-scheme = root.dark-look ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; root.detail-docked = root.detail-fits; root.narrow = self.width < 1340px; root.rail = self.width < 1100px; }

    in property <string> storage-status;
    in property <string> collector-status;
    // 0 delivering, 1 waiting for the first delivery after start, 2 silent.
    in property <int> collector-state: 1;
    in property <string> build-version;
    in property <string> range-label;
    in property <string> selected-name: "选择一条活动";
    in property <image> selected-icon;
    in property <color> selected-tint: Theme.ink-3;
    in property <string> opened-value: "0 秒";
    in property <string> displayed-value: "0 秒";
    in property <string> focused-value: "0 秒";
    in property <string> background-value: "0 秒";
    in property <string> input-value: "键盘 0 · 鼠标 0";
    in property <string> keyboard-value: "0 次";
    in property <string> mouse-value: "0 次";
    in property <string> range-keyboard: "0";
    in property <string> range-mouse: "0";
    in property <string> coverage-value: "尚无记录";
    in property <bool> has-gaps: false;
    in property <string> retention-value: "30 天 · 100 MiB";
    in property <int> retention-days: 30;
    // The space limit in MiB, how much the records use, and how far back they reach.
    in property <int> retention-mib: 100;
    in property <int> retention-used-mib: 0;
    in property <string> retention-usage;
    // The local date a retention of so many days would keep back to.
    pure callback retention-cutoff(int) -> string;
    callback retention-space-selected(int);
    in-out property <string> action-status;
    // How a status reads: 0 a result that fades by itself, 1 work still going,
    // 2 a failure that stays until dismissed.
    pure callback status-kind(string) -> int;
    // The file a status names, or "" when it names none.
    pure callback status-path(string) -> string;
    callback open-folder(string);
    callback check-updates;
    callback open-project;
    private property <bool> toast-hover;
    in property <bool> action-busy;
    in property <string> calendar-date;
    in property <bool> is-today;
    // The shared range in words, and its day and today as yyyymmdd; the day is
    // 0 while the range is a recent stretch over several days.
    in property <string> range-title;
    in property <int> today-ymd;
    in property <int> selected-ymd;
    in property <string> focus-total;
    in property <bool> can-next-day;
    // The home history and the activity picked in it.
    in property <[HistoryItem]> history;
    in property <[float]> history-positions;
    in property <length> history-content-height;
    out property <length> history-visible-height;
    in property <[DayAnchor]> day-anchors;
    // The day the history shows, as yyyymmdd and in words, and the earliest day
    // it can show.
    in property <int> history-day-ymd;
    in property <string> history-day-label;
    in property <int> earliest-ymd;
    // A search's progress and result, and whether it found nothing at all.
    in property <string> history-search-status;
    in property <bool> history-search-empty;
    // New activity arrived while the user looked further back.
    in-out property <bool> history-has-new;
    changed history-follow => { if root.history-follow { root.history-has-new = false; } }
    // Grows to open the date jump from elsewhere in the history.
    private property <int> jump-requests;
    // A page's range set from the timeline, in words; empty otherwise.
    in property <string> range-origin;
    in-out property <length> history-scroll: 0px;
    // The history stays at its newest rows until the user scrolls up.
    in-out property <bool> history-follow: true;
    // Bumped to bring the history back to now.
    in-out property <int> history-to-end: 0;
    in-out property <string> history-query;
    in-out property <string> history-selected;
    in-out property <bool> detail-open: false;
    in property <string> detail-name;
    in property <image> detail-icon;
    in property <color> detail-tint: Theme.ink-3;
    in property <string> detail-when;
    in property <string> detail-duration;
    in property <string> detail-note;
    // The activity's own application, and the others: switched to in between,
    // or on screen alongside. Times arrive once read; meanwhile `loading`.
    in property <Participant> detail-main;
    in property <[Participant]> detail-interleaved;
    in property <[Participant]> detail-same-screen;
    in property <bool> detail-loading;
    in property <string> detail-keyboard;
    in property <string> detail-mouse;
    in property <[AppRow]> apps;
    in property <[AppRow]> filtered-apps;
    // Statistics cover all records unless narrowed to the shared range.
    in-out property <bool> stats-all: true;
    in property <string> apps-range;
    in property <[WindowRow]> windows;
    in property <[SegmentRow]> segments;
    in property <[SnapshotRow]> snapshots;
    in property <image> snapshot-preview;
    in property <string> snapshot-detail: "选择快照以查看详情";
    in property <string> snapshot-policy-label: "快照已关闭";
    // What the list holds, and whether it stops short of the range.
    in property <string> snapshot-summary;
    in property <bool> snapshot-truncated;
    // When the selected snapshot was taken, for the delete confirmation.
    in property <string> snapshot-selected-time;
    in property <string> snapshot-exclusion-label: "先选择应用";
    in property <bool> snapshot-enabled;
    in property <int> snapshot-interval-minutes: 5;
    in property <int> snapshot-retention-days: 30;
    in property <string> snapshot-capacity;
    in property <bool> snapshot-all-displays;
    in property <bool> snapshot-deletable;
    // Ticking snapshots to delete several at once.
    in-out property <bool> snapshot-selecting: false;
    in property <int> snapshot-checked-count: 0;
    in property <[ReportAppRow]> report-apps;
    in property <string> report-summary: "为当前时段生成一份本地报告。";
    in property <bool> report-ready;
    // The report's figures: focus, coverage and what it leaves out, input,
    // snapshots; and who made it when, in small print.
    in property <string> report-focus;
    in property <string> report-coverage;
    in property <string> report-coverage-note;
    in property <[string]> report-gaps;
    in property <string> report-input;
    in property <string> report-input-note;
    in property <string> report-snapshots;
    in property <string> report-snapshot-note;
    in property <string> report-footer;
    // The report covers another range than the one chosen now.
    in property <bool> report-stale;
    in property <string> report-stale-text;
    private property <bool> report-gaps-open;
    // The totals on screen are being gathered, or belong to another range.
    in property <bool> apps-loading;
    // The ends of the application's activity bar, in words.
    in property <string> segments-start;
    in property <string> segments-end;
    // Windows in all; `windows` holds the longest few unless expanded.
    in property <int> windows-total;
    in-out property <int> selected-index: -1;
    in-out property <int> snapshot-selected-index: -1;
    in-out property <int> page: 0;
    // 0 recording and privacy, 1 snapshots, 2 application rules, 3 data and
    // storage, 5 about, 6 general.
    in-out property <int> settings-tab: 6;
    in property <bool> startup-enabled: false;
    in property <bool> startup-available: false;
    in property <bool> startup-busy: false;
    in property <string> startup-status;
    // 0 applications, 1 keys and system, 2 local report.
    in-out property <int> stats-tab: 0;
    in-out property <bool> windows-expanded: false;
    in-out property <bool> snapshot-open: false;
    in-out property <bool> report-open: false;
    // The application detail opens when the user picks an application.
    in-out property <bool> app-detail-open: false;
    in-out property <bool> settings-open: false;
    // Bumped to repaint the whole window, see the layer at the end.
    in-out property <int> repaint-epoch: 0;
    private property <bool> clear-confirm-open: false;
    private property <bool> delete-snapshot-confirm: false;
    private property <bool> delete-checked-confirm: false;
    // The selected snapshot over the whole window, fitted or at its own pixels.
    in-out property <bool> snapshot-viewer-open: false;
    // Whether the viewer can step to a snapshot with an image on either side.
    in property <bool> snapshot-can-previous;
    in property <bool> snapshot-can-next;
    in property <string> snapshot-position;
    // The width the snapshot list was dragged to, and the width it gets: at
    // least one column, with room left for the preview.
    in-out property <length> snapshot-list-width: 432px;
    private property <length> snapshot-room;
    private property <length> snapshot-list-shown: 432px;
    // The preview takes what the list and the 16px divider leave.
    private property <bool> snapshot-preview-narrow: root.snapshot-room - root.snapshot-list-shown - 16px < 460px;
    function fit-snapshot-list() {
        root.snapshot-list-shown = root.snapshot-room <= 0px ? root.snapshot-list-width : max(176px, min(root.snapshot-list-width, root.snapshot-room - 356px));
    }
    changed snapshot-list-width => { root.fit-snapshot-list(); }
    changed snapshot-room => { root.fit-snapshot-list(); }
    // A shorter retention deletes history at once, so it is confirmed first.
    private property <int> pending-retention-days: -1;
    private property <bool> pending-retention-snapshots: false;
    private property <bool> retention-confirm-open: root.pending-retention-days >= 0;
    private property <int> pending-space-mib: -1;
    private property <bool> any-modal-open: CollectionState.confirm != 0 || root.clear-confirm-open || root.delete-snapshot-confirm || root.delete-checked-confirm || root.retention-confirm-open || root.pending-space-mib >= 0 || DataState.restore-confirm != 0 || DataState.move-phase != 0 || root.snapshot-viewer-open;
    changed any-modal-open => { Theme.modal-open = root.any-modal-open; }
    // The viewer shows only while there is an image; without one it closes
    // rather than leaving an invisible modal behind.
    changed snapshot-preview => {
        if root.snapshot-viewer-open && root.snapshot-preview.width == 0 {
            root.snapshot-viewer-open = false;
            Theme.modal-open = root.any-modal-open;
            if !Theme.modal-open { snapshots-nav.focus(); }
        }
    }
    private property <bool> recording-unavailable: !CollectionState.paused && root.collector-state == 2;
    private property <color> recording-tone: CollectionState.paused ? Theme.warn-line : root.collector-state == 2 ? Theme.danger : root.collector-state == 1 ? Theme.ink-4 : Theme.ok;
    in-out property <string> app-search;
    private property <bool> activity-detail: root.detail-open && root.page == 0;
    private property <bool> app-detail: root.page == 3 && root.stats-tab == 0 && root.app-detail-open && root.selected-index >= 0;
    // The detail docks beside the content when both fit (sidebar 236px and the
    // sheet's 10px margin aside), otherwise it floats over the content's right edge.
    private property <length> detail-width: root.activity-detail ? 380px : root.app-detail ? 360px : 0px;
    // Set from a change handler: the window's width depends on the layout that
    // the docked pane takes room in, so a plain binding would loop.
    private property <bool> detail-fits: root.width - (root.rail ? 82px : 246px) - 380px >= main-area.min-width;
    private property <bool> detail-docked;
    changed detail-fits => { root.detail-docked = root.detail-fits; }
    private property <string> manual-start: "09:00";
    private property <string> manual-end: "18:00";

    callback navigate(int);
    callback app-search-changed;
    callback apps-scope-changed;
    callback day-selected(int);
    callback date-selected(string);
    callback today-selected;
    // A day counted back from today: 1 is yesterday.
    callback days-ago-selected(int);
    callback time-range-selected(string, string);
    callback history-load-more;
    callback history-viewport-changed;
    callback history-data-ready;
    callback history-search(string);
    callback history-select(string);
    callback history-close;
    callback history-jump(string);
    // Selects the activity before (-1) or after (1) the selected one.
    callback history-step(int);
    callback history-detail-ready;
    // On the activity with this key: 0 show its snapshots, 2 select its
    // application.
    callback detail-action(string, int);
    // Puts back the range a page had before the timeline set it.
    callback range-origin-restore;
    callback app-selected(int);
    callback horizon-selected(int);
    callback retention-selected(int);
    callback run-cleanup;
    callback clear-all;
    callback snapshot-opened;
    callback general-opened;
    // 0 follows the system, 1 light, 2 dark.
    callback theme-mode-selected(int);
    callback startup-changed(bool);
    callback snapshot-row-selected(int);
    // Select the nearest snapshot with an image before (-1) or after (1) the
    // given one; false when there is none.
    callback snapshot-step(int, int) -> bool;
    callback snapshot-delete-selected;
    // The grid's first and last visible snapshot, which get thumbnails.
    callback snapshot-visible(int, int);
    // Tick or untick one snapshot; with Shift, tick the span from the last one.
    callback snapshot-check(int, bool);
    callback snapshot-check-all(bool);
    callback snapshot-delete-checked;
    callback snapshot-capture-now;
    // A capture finished: what to say, and the slot to select, in ms.
    callback snapshot-captured(string, string);
    callback snapshot-toggle-enabled;
    callback snapshot-interval-selected(int);
    callback snapshot-toggle-target;
    callback snapshot-retention-selected(int);
    callback snapshot-toggle-exclusion;
    callback report-generate;
    // Saves the report on screen: 0 JSON, 1 CSV.
    callback report-export(int);

    pure function shortens(current-days: int, next-days: int) -> bool {
        // Zero means keep forever.
        return next-days > 0 && (current-days == 0 || next-days < current-days);
    }
    function choose-retention(days: int) {
        if root.shortens(root.retention-days, days) {
            root.pending-retention-snapshots = false;
            root.pending-retention-days = days;
        } else {
            root.retention-selected(days);
        }
    }
    function choose-space(mib: int) {
        if mib < root.retention-used-mib {
            root.pending-space-mib = mib;
        } else {
            root.retention-space-selected(mib);
        }
    }
    function choose-snapshot-retention(days: int) {
        if root.shortens(root.snapshot-retention-days, days) {
            root.pending-retention-snapshots = true;
            root.pending-retention-days = days;
        } else {
            root.snapshot-retention-selected(days);
        }
    }
    // The statistics gather again after their scope or range changes.
    function stats-changed() {
        root.apps-scope-changed();
        if root.stats-tab == 1 { CollectionState.action(7); }
    }
    // 0 show its snapshots, 2 open its application's rules.
    function act-on-activity(key: string, action: int) {
        root.detail-action(key, action);
        // The rules page opens on the application the activity selected.
        if action == 2 { root.open-settings(2); }
    }
    pure function two(value: int) -> string { return (value < 10 ? "0" : "") + value; }
    function delay-search() { search-delay.start(); search-delay.restart(); }
    function stop-search-delay() { search-delay.stop(); }
    // Whether the window is too narrow for every label in the toolbar. Set on
    // change, since the window's own width depends on what it holds.
    private property <bool> narrow;
    // Below this the sidebar shows icons only.
    private property <bool> rail;
    changed width => { root.narrow = self.width < 1340px; root.rail = self.width < 1100px; }
    function sidebar-navigate(page: int) {
        root.app-detail-open = false;
        root.range-origin-restore();
        root.navigate(page);
    }
    function open-settings(tab: int) {
        // The page already shown keeps what is being typed into it.
        if !root.settings-open || root.settings-tab != tab {
            root.settings-open = true;
            root.show-settings(tab);
        }
    }
    function pick-settings(tab: int) {
        if root.settings-tab != tab { root.show-settings(tab); }
    }
    function close-settings() {
        root.settings-open = false;
        root.snapshot-open = root.page == 2;
        // Settings and the statistics page share the collection panel.
        if root.page == 3 && root.stats-tab == 1 { CollectionState.page = 1; CollectionState.action(7); }
    }
    function show-settings(tab: int) {
        root.settings-tab = tab;
        root.snapshot-open = tab == 1;
        if tab == 1 { root.snapshot-opened(); }
        if tab == 2 { CollectionState.page = 0; CollectionState.opened(); }
        if tab == 6 { root.general-opened(); }
    }
    // Resuming is one click; pausing asks for how long.
    function toggle-recording() {
        if CollectionState.paused {
            CollectionState.paused = false;
            CollectionState.action(0);
        } else {
            pause-menu.show();
        }
    }
    pause-menu := PopupWindow {
        x: root.rail ? 76px : 240px;
        y: root.height - 260px;
        width: 220px;
        height: pause-sheet.preferred-height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px; border-color: Theme.line-strong;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow-strong;
            pause-sheet := VerticalLayout {
                padding: 8px; spacing: 2px;
                Text { x: 12px; height: 30px; text: "暂停记录多久？"; color: Theme.ink-3; font-size: 12px; vertical-alignment: center; }
                QuickRange { text: "15 分钟"; clicked => { pause-menu.close(); CollectionState.pause-for(15); } }
                QuickRange { text: "1 小时"; clicked => { pause-menu.close(); CollectionState.pause-for(60); } }
                QuickRange { text: "直到明天"; clicked => { pause-menu.close(); CollectionState.pause-for(-2); } }
                QuickRange { text: "直到手动继续"; clicked => { pause-menu.close(); CollectionState.pause-for(-1); } }
            }
        }
    }
    function stop-selecting() {
        root.snapshot-selecting = false;
        root.snapshot-check-all(false);
    }
    function close-detail() {
        if root.activity-detail { root.history-close(); }
        root.app-detail-open = false;
    }

    toast-timer := Timer {
        interval: 4s;
        running: false;
        triggered => { self.running = false; root.action-status = ""; }
    }
    // A result fades after a while unless the pointer rests on it; progress and
    // failures stay until something replaces or dismisses them.
    function arm-toast() {
        if root.action-status != "" && root.status-kind(root.action-status) == 0 && !root.toast-hover {
            toast-timer.restart();
        } else {
            toast-timer.stop();
        }
    }
    changed action-status => { root.toast-hover = false; root.arm-toast(); }

    search-delay := Timer {
        interval: 250ms;
        running: false;
        triggered => { self.running = false; root.history-search(root.history-query); }
    }

    body := FocusScope {
        enabled: !root.any-modal-open && !root.settings-open;
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if root.any-modal-open { return accept; }
            if event.text == Key.Escape && (root.activity-detail || root.app-detail) {
                root.close-detail();
                return accept;
            }
            if event.text == Key.Escape && root.page == 2 && root.snapshot-selecting {
                root.stop-selecting();
                return accept;
            }
            return reject;
        }
        capture-key-released(event) => {
            if root.any-modal-open { return accept; }
            return reject;
        }
        HorizontalLayout {
            // Sidebar on the window canvas.
            VerticalLayout {
                width: root.rail ? 72px : 236px;
                padding-left: root.rail ? 10px : 14px; padding-right: root.rail ? 6px : 10px; padding-top: 18px; padding-bottom: 14px;
                spacing: 3px;
                HorizontalLayout {
                    height: 46px; padding-left: root.rail ? 13px : 8px; spacing: 11px;
                    Rectangle { width: 30px; Image { width: 30px; height: 30px; source: @image-url("icons/logo.svg"); } }
                    if !root.rail : VerticalLayout {
                        alignment: center; spacing: 1px;
                        Text { text: "Timelens"; color: Theme.ink; font-family: Theme.font-display; font-size: 17px; font-weight: 700; }
                        Text { text: "本机时间回看"; color: Theme.ink-3; font-size: 11px; }
                    }
                }
                Rectangle { height: 14px; }
                NavItem { compact: root.rail; text: "时间线"; icon: @image-url("icons/clock.svg"); selected: root.page == 0; clicked => { root.sidebar-navigate(0); } }
                NavItem { compact: root.rail; text: "统计与报告"; icon: @image-url("icons/chart-bar.svg"); selected: root.page == 3; clicked => { root.sidebar-navigate(3); } }
                snapshots-nav := NavItem { compact: root.rail; text: "快照"; icon: @image-url("icons/photo.svg"); selected: root.page == 2; clicked => { root.sidebar-navigate(2); } }
                Rectangle { vertical-stretch: 1; }
                // A narrow sidebar keeps only the state dot and the switch.
                if root.rail : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout { alignment: center; Dot { tone: root.recording-tone; halo: !CollectionState.paused && root.collector-state == 0; } }
                    Action {
                        height: 34px;
                        icon: CollectionState.paused ? @image-url("icons/player-play.svg") : @image-url("icons/player-pause.svg");
                        accessible-label: CollectionState.paused ? "继续记录" : "暂停记录";
                        accent: CollectionState.paused;
                        enabled: !CollectionState.busy && !root.action-busy;
                        clicked => { root.toggle-recording(); }
                    }
                }
                if !root.rail : Rectangle {
                    height: recording.preferred-height;
                    border-radius: 12px;
                    background: Theme.canvas-card;
                    border-width: 1px; border-color: Theme.line;
                    recording := VerticalLayout {
                        padding: 12px; spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle { width: 16px; Dot { tone: root.recording-tone; halo: !CollectionState.paused && root.collector-state == 0; } }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: CollectionState.paused ? "已暂停记录" : root.collector-state == 2 ? "采集器未连接" : root.collector-state == 1 ? "正在连接采集器" : "正在记录";
                                    color: root.recording-unavailable ? Theme.danger : Theme.ink;
                                    font-size: 13px; font-weight: 600;
                                }
                                Text {
                                    text: CollectionState.paused ? (CollectionState.resume-label != "" ? CollectionState.resume-label : "直到手动继续") : root.collector-state == 2 ? "会自动尝试重启采集器" : root.collector-state == 1 ? "等待首次上报…" : "数据只保存在这台电脑";
                                    color: Theme.ink-3; font-size: 11px; wrap: word-wrap;
                                }
                            }
                        }
                        Action {
                            height: 30px;
                            text: CollectionState.paused ? "继续记录" : "暂停记录";
                            icon: CollectionState.paused ? @image-url("icons/player-play.svg") : @image-url("icons/player-pause.svg");
                            accent: CollectionState.paused;
                            enabled: !CollectionState.busy && !root.action-busy;
                            clicked => { root.toggle-recording(); }
                        }
                    }
                }
                Rectangle { height: 8px; }
                settings-nav := NavItem { compact: root.rail; text: "设置"; icon: @image-url("icons/settings.svg"); selected: root.settings-open; clicked => { root.open-settings(root.settings-tab); } }
            }

            // The content sheet.
            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-top: 10px; padding-right: 10px; padding-bottom: 10px;
                    Rectangle {
                        background: Theme.layer;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.line;
                        drop-shadow-blur: 18px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.shadow-soft;
                        clip: true;
                        HorizontalLayout {
                            main-area := Rectangle {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding-top: 24px; padding-left: 32px; padding-right: 32px; padding-bottom: 16px;
                                    spacing: 14px;

                                    // ───── Timeline ─────
                                    if root.page == 0 : HorizontalLayout {
                                        height: 36px; spacing: 8px;
                                        LineEdit {
                                            min-width: 160px; preferred-width: 300px; horizontal-stretch: 0;
                                            text <=> root.history-query;
                                            placeholder-text: "搜索应用，例如 微信";
                                            // Searching waits for a pause in typing.
                                            edited(text) => { root.delay-search(); }
                                            accepted => { root.stop-search-delay(); root.history-search(root.history-query); }
                                        }
                                        if root.history-query != "" : VerticalLayout {
                                            alignment: center;
                                            Action {
                                                quiet: true; icon: @image-url("icons/x.svg"); accessible-label: "清除搜索";
                                                clicked => { root.stop-search-delay(); root.history-query = ""; root.history-search(""); }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        JumpPicker {
                                            requests: root.jump-requests;
                                            compact: root.narrow;
                                            today-ymd: root.today-ymd;
                                            earliest-ymd: root.earliest-ymd;
                                            current-ymd: root.history-follow ? root.today-ymd : root.history-day-ymd;
                                            jump(date) => { root.history-jump(date); }
                                        }
                                    }
                                    if root.page == 0 && root.history-query != "" : Note { text: root.history-search-status; font-size: 12px; }
                                    if root.page == 0 : Rectangle {
                                        vertical-stretch: 1;
                                        // The pinned day header slides up when the next day
                                        // arrives; keep it off the toolbar above.
                                        clip: true;
                                        // ↑/↓ step through the activities; End goes back to now.
                                        history-keys := FocusScope {
                                            focus-on-click: false;
                                            focus-on-tab-navigation: false;
                                            key-pressed(event) => {
                                                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                                                    root.history-step(event.text == Key.UpArrow ? -1 : 1);
                                                    // The row that had focus may scroll away; keep the keys here.
                                                    history-keys.focus();
                                                    return accept;
                                                }
                                                if event.text == Key.End { root.history-follow = true; root.history-to-end += 1; return accept; }
                                                return reject;
                                            }
                                            // Earlier rows above, now at the bottom. Rows have fixed
                                            // heights, so the view can keep its place exactly.
                                            history-list := ScrollView {
                                                property <length> bottom: min(0px, self.visible-height - self.viewport-height);
                                                property <int> to-end: root.history-to-end;
                                                viewport-y <=> root.history-scroll;
                                                viewport-height: root.history-content-height + 20px;
                                                changed visible-height => {
                                                    root.history-visible-height = self.visible-height;
                                                    root.history-viewport-changed();
                                                }
                                                changed bottom => { if root.history-follow { self.viewport-y = self.bottom; } }
                                                changed to-end => { self.viewport-y = self.bottom; }
                                                changed viewport-y => {
                                                    root.history-follow = self.viewport-y <= self.bottom + 2px;
                                                    if -self.viewport-y < 160px && self.viewport-y > self.bottom { root.history-load-more(); }
                                                    root.history-viewport-changed();
                                                }
                                                Rectangle {
                                                    width: history-list.visible-width;
                                                    height: root.history-content-height + 20px;
                                                    for item[index] in root.history : HistoryRow {
                                                        y: root.history-positions[index] * 1px;
                                                        width: parent.width;
                                                        item: item;
                                                        selected: item.key != "" && item.key == root.history-selected;
                                                        recording: CollectionState.paused ? 3 : root.collector-state == 2 ? 2 : root.collector-state == 1 ? 1 : 0;
                                                        select => { if item.kind == 5 { root.history-load-more(); } else { root.history-select(item.key); } }
                                                        act(action) => { root.act-on-activity(item.key, action); }
                                                        resume => { CollectionState.paused = false; CollectionState.action(0); }
                                                        open-settings => { root.open-settings(0); }
                                                    }
                                                }
                                            }
                                            // The current day's header stays pinned while its rows scroll
                                            // by; the next day's header pushes it up.
                                            for anchor in root.day-anchors : Rectangle {
                                                x: 0px; y: 0px; width: history-list.visible-width; height: 0px;
                                                if -history-list.viewport-y > anchor.top + 4px && -history-list.viewport-y < anchor.bottom : StickyDay {
                                                    x: 0px;
                                                    y: min(0px, anchor.bottom - (-history-list.viewport-y) - 60px);
                                                    width: parent.width;
                                                    title: anchor.title; subtitle: anchor.subtitle; duration: anchor.duration; apps: anchor.apps; shares: anchor.shares;
                                                    clicked => { root.jump-requests += 1; }
                                                }
                                            }
                                        }
                                        if root.history-search-empty : VerticalLayout {
                                            alignment: center; spacing: 12px;
                                            Text { text: "最近 30 天没有找到“" + root.history-query + "”"; color: Theme.ink-2; font-size: 14px; horizontal-alignment: center; }
                                            HorizontalLayout {
                                                alignment: center;
                                                Action { text: "清除搜索"; clicked => { root.stop-search-delay(); root.history-query = ""; root.history-search(""); } }
                                            }
                                        }
                                        // Back to now, once the user has scrolled away from it.
                                        if !root.history-follow : Rectangle {
                                            x: parent.width - self.width - 24px; y: parent.height - self.height - 16px;
                                            width: back-now.min-width; height: 34px;
                                            border-radius: 8px;
                                            drop-shadow-blur: 14px; drop-shadow-offset-y: 4px; drop-shadow-color: Theme.shadow-strong;
                                            back-now := Action {
                                                text: root.history-has-new ? "有新活动" : "回到现在";
                                                icon: @image-url("icons/arrow-down.svg");
                                                accent: root.history-has-new;
                                                clicked => { root.history-follow = true; root.history-to-end += 1; }
                                            }
                                        }
                                    }

                                    // ───── Snapshots ─────
                                    if root.page == 2 && root.snapshot-selecting : PageHeader {
                                        title: "已选 " + root.snapshot-checked-count + " 张";
                                        subtitle: "点选图片；按住 Shift 再点另一张可选中这段时间。全选只含列表中已显示的快照。";
                                        VerticalLayout { alignment: center; Action { quiet: true; text: "全选"; clicked => { root.snapshot-check-all(true); } } }
                                        VerticalLayout { alignment: center; Action { quiet: true; text: "全不选"; enabled: root.snapshot-checked-count > 0; clicked => { root.snapshot-check-all(false); } } }
                                        VerticalLayout { alignment: center; Action { text: "删除…"; icon: @image-url("icons/trash.svg"); danger: true; enabled: root.snapshot-checked-count > 0 && !root.action-busy; clicked => { root.delete-checked-confirm = true; } } }
                                        VerticalLayout { alignment: center; Action { text: "取消"; accessible-label: "取消选择（Esc）"; clicked => { root.stop-selecting(); } } }
                                    }
                                    if root.page == 2 && !root.snapshot-selecting : PageHeader {
                                        title: "快照";
                                        subtitle: root.snapshot-summary;
                                        if root.range-origin != "" : VerticalLayout { alignment: center; OriginTag { text: root.range-origin; clear => { root.range-origin-restore(); } } }
                                        RangePicker {
                                            label: root.range-title; can-next: root.can-next-day; is-today: root.is-today;
                                            today-ymd: root.today-ymd; selected-ymd: root.selected-ymd;
                                            start <=> root.manual-start; end <=> root.manual-end;
                                            step(offset) => { root.day-selected(offset); }
                                            today => { root.today-selected(); }
                                            days-ago(days) => { root.days-ago-selected(days); }
                                            horizon(hours) => { root.horizon-selected(hours); }
                                            day(date) => { root.date-selected(date); }
                                            span(a, b) => { root.time-range-selected(a, b); }
                                        }
                                        Rectangle { width: 6px; }
                                        VerticalLayout { alignment: center; Action { quiet: true; icon: @image-url("icons/settings.svg"); accessible-label: "快照设置"; clicked => { root.open-settings(1); } } }
                                        if root.snapshots.length > 0 : VerticalLayout {
                                            alignment: center;
                                            Action { text: "选择"; icon: @image-url("icons/checkbox.svg"); clicked => { root.snapshot-selecting = true; } }
                                        }
                                        VerticalLayout { alignment: center; Action { text: "立即拍摄"; icon: @image-url("icons/camera.svg"); accent: true; enabled: !root.action-busy; clicked => { root.snapshot-capture-now(); } } }
                                    }
                                    if root.page == 2 && root.snapshots.length > 0 : snapshot-split := HorizontalLayout {
                                        vertical-stretch: 1;
                                        init => { root.snapshot-room = self.width; }
                                        changed width => { root.snapshot-room = self.width; }
                                        snapshot-list := VerticalLayout {
                                            width: root.snapshot-list-shown;
                                            spacing: 8px;
                                            grid-keys := FocusScope {
                                                width: 0px; height: 0px;
                                                focus-on-click: false;
                                                key-pressed(event) => {
                                                    if root.snapshot-selecting && event.modifiers.control && (event.text == "a" || event.text == "A") { root.snapshot-check-all(true); return accept; }
                                                    if root.snapshot-selecting || root.snapshot-selected-index < 0 { return reject; }
                                                    if event.text == Key.LeftArrow { snapshot-grid.move-by(root.snapshot-selected-index, -1); return accept; }
                                                    if event.text == Key.RightArrow { snapshot-grid.move-by(root.snapshot-selected-index, 1); return accept; }
                                                    if event.text == Key.UpArrow { snapshot-grid.move-by(root.snapshot-selected-index, -snapshot-grid.columns); return accept; }
                                                    if event.text == Key.DownArrow { snapshot-grid.move-by(root.snapshot-selected-index, snapshot-grid.columns); return accept; }
                                                    if event.text == Key.Delete && root.snapshot-deletable { root.delete-snapshot-confirm = true; return accept; }
                                                    return reject;
                                                }
                                            }
                                            snapshot-grid := ListView {
                                                vertical-stretch: 1;
                                                // As many columns of about 128px as fit, clear of the scroll
                                                // bar. Rows have fixed heights, so the visible snapshots
                                                // follow from the scroll position.
                                                property <int> columns: max(1, floor((self.visible-width - 12px) / 132px));
                                                property <length> tile-width: (self.visible-width - 16px - (self.columns - 1) * 4px) / self.columns;
                                                property <length> row-height: (self.tile-width - 8px) * 9 / 16 + 31px;
                                                property <int> first-row: max(0, floor(-self.viewport-y / self.row-height));
                                                property <int> last-row: floor((-self.viewport-y + self.visible-height) / self.row-height);
                                                function report-visible() { root.snapshot-visible(self.first-row * self.columns, (self.last-row + 1) * self.columns - 1); }
                                                // Moves the selection with the arrow keys and keeps it in view.
                                                function move-by(from: int, step: int) {
                                                    let to = from + step;
                                                    if to < 0 || to >= root.snapshots.length { return; }
                                                    root.snapshot-row-selected(to);
                                                    let top = floor(to / self.columns) * self.row-height;
                                                    if top < -self.viewport-y { self.viewport-y = -top; }
                                                    if top + self.row-height > -self.viewport-y + self.visible-height { self.viewport-y = -(top + self.row-height - self.visible-height); }
                                                    grid-keys.focus();
                                                }
                                                changed first-row => { self.report-visible(); }
                                                changed last-row => { self.report-visible(); }
                                                changed columns => { self.report-visible(); }
                                                for row in Math.ceil(root.snapshots.length / snapshot-grid.columns) : Rectangle {
                                                    height: snapshot-grid.row-height;
                                                    for column in snapshot-grid.columns : cell := Rectangle {
                                                        property <int> index: row * snapshot-grid.columns + column;
                                                        x: column * (snapshot-grid.tile-width + 4px);
                                                        width: snapshot-grid.tile-width;
                                                        if cell.index < root.snapshots.length : SnapshotTile {
                                                            width: parent.width; height: parent.height - 4px;
                                                            item: root.snapshots[cell.index];
                                                            current: cell.index == root.snapshot-selected-index;
                                                            selecting: root.snapshot-selecting;
                                                            activate(shift) => {
                                                                if root.snapshot-selecting { root.snapshot-check(cell.index, shift); } else { root.snapshot-row-selected(cell.index); }
                                                            }
                                                            key(code) => {
                                                                if code == 4 {
                                                                    if root.snapshot-selecting { if root.snapshot-checked-count > 0 { root.delete-checked-confirm = true; } }
                                                                    else if root.snapshot-deletable && cell.index == root.snapshot-selected-index { root.delete-snapshot-confirm = true; }
                                                                } else if !root.snapshot-selecting {
                                                                    snapshot-grid.move-by(root.snapshot-selected-index < 0 ? cell.index : root.snapshot-selected-index,
                                                                        code == 0 ? -1 : code == 1 ? 1 : code == 2 ? -snapshot-grid.columns : snapshot-grid.columns);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if root.snapshot-truncated : Note { text: "只显示最近 500 条。缩小时段可以查看更早的快照。"; font-size: 12px; }
                                        }
                                        // The divider: drag to resize the list, double-click for the default.
                                        Rectangle {
                                            width: 16px;
                                            divider := TouchArea {
                                                mouse-cursor: MouseCursor.col-resize;
                                                moved => {
                                                    if self.pressed {
                                                        root.snapshot-list-width = max(176px, min(snapshot-split.width - 356px, snapshot-list.width + self.mouse-x - self.pressed-x));
                                                        root.snapshot-list-shown = root.snapshot-list-width;
                                                    }
                                                }
                                                double-clicked => { root.snapshot-list-width = 432px; }
                                            }
                                            Rectangle {
                                                width: divider.pressed || divider.has-hover ? 4px : 2px;
                                                height: 40px;
                                                border-radius: 2px;
                                                background: divider.pressed ? Theme.brand : divider.has-hover ? Theme.ink-4 : Theme.line-strong;
                                            }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 14px;
                                            background: Theme.photo-bg;
                                            clip: true;
                                            Image {
                                                x: 14px; y: 14px; width: parent.width - 28px; height: parent.height - 76px;
                                                source: root.snapshot-preview; image-fit: contain;
                                                if root.snapshot-preview.width > 0 : TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.snapshot-viewer-open = true; }
                                                }
                                            }
                                            if root.snapshot-preview.width == 0 : VerticalLayout {
                                                y: 0px; height: parent.height - 62px;
                                                alignment: center; spacing: 10px;
                                                HorizontalLayout { alignment: center; Image { width: 30px; height: 30px; source: @image-url("icons/photo.svg"); colorize: #ffffff66; } }
                                                Text { text: root.snapshot-selected-index < 0 ? "从左侧选择一张快照预览" : root.snapshot-detail; color: #ffffffb3; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                                            }
                                            Rectangle {
                                                y: parent.height - 62px; height: 62px;
                                                background: #0d111bcc;
                                                HorizontalLayout {
                                                    padding-left: 18px; padding-right: 12px; spacing: 8px;
                                                    Text { text: root.snapshot-selecting ? "已选 " + root.snapshot-checked-count + " 张，可在上方删除" : root.snapshot-detail; color: #ffffffd9; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                    // Icons only while the preview is narrow, so the size still shows.
                                                    if !root.snapshot-selecting : VerticalLayout { alignment: center; Action { text: root.snapshot-preview-narrow ? "" : "放大"; accessible-label: "放大"; icon: @image-url("icons/search.svg"); enabled: root.snapshot-preview.width > 0; clicked => { root.snapshot-viewer-open = true; } } }
                                                    if !root.snapshot-selecting : VerticalLayout { alignment: center; Action { text: root.snapshot-preview-narrow ? "" : "导出"; accessible-label: "导出"; icon: @image-url("icons/download.svg"); enabled: root.snapshot-deletable && !DataState.busy; clicked => { DataState.action(7); } } }
                                                    if !root.snapshot-selecting : VerticalLayout { alignment: center; Action { text: root.snapshot-preview-narrow ? "" : "删除…"; accessible-label: "删除…"; icon: @image-url("icons/trash.svg"); danger: true; enabled: root.snapshot-deletable; clicked => { root.delete-snapshot-confirm = true; } } }
                                                }
                                            }
                                        }
                                    }
                                    if root.page == 2 && root.snapshots.length == 0 : Rectangle {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            width: min(420px, parent.width); height: self.preferred-height;
                                            x: (parent.width - self.width) / 2; y: max(0px, (parent.height - self.height) * 0.36);
                                            spacing: 12px;
                                            Rectangle {
                                                height: 64px;
                                                Rectangle {
                                                    width: 64px; height: 64px; border-radius: 32px; background: Theme.surface-2;
                                                    Image { width: 28px; height: 28px; source: @image-url("icons/camera.svg"); colorize: Theme.ink-3; }
                                                }
                                            }
                                            Text { text: "这段时间没有快照"; color: Theme.ink; font-size: 17px; font-weight: 600; horizontal-alignment: center; }
                                            Note {
                                                text: root.snapshot-enabled ? "定时快照已开启，新的快照会按设置的间隔出现在这里。快照只保存在本机。" : "定时快照已关闭，可以在快照设置中开启，或者现在拍一张。";
                                                horizontal-alignment: center;
                                            }
                                            HorizontalLayout {
                                                alignment: center; spacing: 8px;
                                                Action { text: "快照设置"; clicked => { root.open-settings(1); } }
                                                Action { text: "立即拍摄"; icon: @image-url("icons/camera.svg"); enabled: !root.action-busy; clicked => { root.snapshot-capture-now(); } }
                                            }
                                        }
                                    }

                                    // ───── Statistics and reports ─────
                                    if root.page == 3 : PageHeader {
                                        title: "统计与报告";
                                        subtitle: "由本机记录直接计算";
                                        if root.range-origin != "" && (root.stats-tab == 2 || !root.stats-all) : VerticalLayout { alignment: center; OriginTag { text: root.range-origin; clear => { root.range-origin-restore(); } } }
                                        // One picker for all three tabs; reports always cover a range.
                                        RangePicker {
                                            label: root.stats-tab != 2 && root.stats-all ? "全部记录" : root.range-title;
                                            allow-all: root.stats-tab != 2;
                                            all: root.stats-tab != 2 && root.stats-all;
                                            can-next: root.can-next-day; is-today: root.is-today;
                                            today-ymd: root.today-ymd; selected-ymd: root.selected-ymd;
                                            start <=> root.manual-start; end <=> root.manual-end;
                                            choose-all => { root.stats-all = true; root.stats-changed(); }
                                            step(offset) => { root.stats-all = false; root.day-selected(offset); root.stats-changed(); }
                                            today => { root.stats-all = false; root.today-selected(); root.stats-changed(); }
                                            days-ago(days) => { root.stats-all = false; root.days-ago-selected(days); root.stats-changed(); }
                                            horizon(hours) => { root.stats-all = false; root.horizon-selected(hours); root.stats-changed(); }
                                            day(date) => { root.stats-all = false; root.date-selected(date); root.stats-changed(); }
                                            span(a, b) => { root.stats-all = false; root.time-range-selected(a, b); root.stats-changed(); }
                                        }
                                    }
                                    if root.page == 3 : HorizontalLayout {
                                        height: 34px; spacing: 8px;
                                        Segmented {
                                            Segment { text: "应用"; icon: @image-url("icons/layout-grid.svg"); selected: root.stats-tab == 0; clicked => { root.stats-tab = 0; } }
                                            Segment { text: "本地报告"; icon: @image-url("icons/file-description.svg"); selected: root.stats-tab == 2; clicked => { root.app-detail-open = false; root.stats-tab = 2; } }
                                            Segment { text: "键位与系统"; icon: @image-url("icons/keyboard.svg"); selected: root.stats-tab == 1; clicked => { root.app-detail-open = false; root.stats-tab = 1; CollectionState.page = 1; CollectionState.action(7); } }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        if root.stats-tab == 0 : Action { text: "应用规则"; icon: @image-url("icons/adjustments-horizontal.svg"); clicked => { root.open-settings(2); } }
                                        if root.stats-tab == 2 && !root.report-ready : HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout { alignment: center; Dot { tone: root.has-gaps ? Theme.warn-line : Theme.ok; } }
                                            Note { text: root.coverage-value; vertical-alignment: center; color: root.has-gaps ? Theme.warn : Theme.ink-3; }
                                        }
                                        if root.stats-tab == 2 : Rectangle { width: 4px; }
                                        if root.stats-tab == 2 : Action { text: root.action-busy ? "正在生成…" : root.report-ready && !root.report-stale ? "重新生成" : "生成本地报告"; icon: @image-url("icons/file-description.svg"); accent: true; enabled: !root.action-busy; clicked => { root.report-generate(); } }
                                    }
                                    // Applications: totals for all records or the chosen range.
                                    if root.page == 3 && root.stats-tab == 0 : Card {
                                        height: overview.preferred-height;
                                        opacity: root.apps-loading && root.apps.length > 0 ? 0.5 : 1;
                                        overview := VerticalLayout {
                                            padding: 18px; spacing: 14px;
                                            HorizontalLayout {
                                                spacing: 18px;
                                                Metric { label: "聚焦总计"; value: root.focus-total; icon: @image-url("icons/clock.svg"); horizontal-stretch: 1; }
                                                Rectangle { width: 1px; background: Theme.line; }
                                                Metric { label: "应用"; value: root.apps.length; icon: @image-url("icons/layout-grid.svg"); horizontal-stretch: 1; }
                                                Rectangle { width: 1px; background: Theme.line; }
                                                Metric { label: "键盘"; value: root.range-keyboard; icon: @image-url("icons/keyboard.svg"); horizontal-stretch: 1; }
                                                Rectangle { width: 1px; background: Theme.line; }
                                                Metric { label: "鼠标点击"; value: root.range-mouse; icon: @image-url("icons/mouse.svg"); horizontal-stretch: 1; }
                                            }
                                            if root.apps.length > 0 : HorizontalLayout {
                                                height: 8px; spacing: 2px;
                                                for app in root.apps : Rectangle { horizontal-stretch: app.focus-ratio; min-width: 0px; border-radius: 2px; background: app.tint; }
                                            }
                                        }
                                    }
                                    if root.page == 3 && root.stats-tab == 0 : HorizontalLayout {
                                        height: 34px;
                                        LineEdit { width: 280px; text <=> root.app-search; placeholder-text: "查找应用"; edited => { root.app-search-changed(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                        Note { text: root.apps-loading ? "正在统计…" : root.apps-range + " · 点选应用查看详情"; vertical-alignment: center; }
                                    }
                                    if root.page == 3 && root.stats-tab == 0 && root.filtered-apps.length > 0 : ListView {
                                        vertical-stretch: 1;
                                        opacity: root.apps-loading ? 0.5 : 1;
                                        for app in root.filtered-apps : Rectangle {
                                            height: 64px;
                                            Rectangle {
                                                y: 2px; height: 60px;
                                                border-radius: 12px;
                                                background: root.app-detail && root.selected-index == app.original-index ? Theme.surface : app-touch.has-hover ? Theme.hover-tint : transparent;
                                                border-width: app-key.has-focus ? 2px : root.app-detail && root.selected-index == app.original-index ? 1px : 0px;
                                                border-color: app-key.has-focus ? Theme.focus : Theme.line;
                                                drop-shadow-blur: root.app-detail && root.selected-index == app.original-index ? 10px : 0px;
                                                drop-shadow-offset-y: 2px;
                                                drop-shadow-color: Theme.shadow-soft;
                                                forward-focus: app-key;
                                                accessible-role: button;
                                                accessible-label: app.name + "，聚焦 " + app.focused;
                                                accessible-action-default => { root.app-detail-open = true; root.app-selected(app.original-index); }
                                                HorizontalLayout {
                                                    padding-left: 14px; padding-right: 18px; spacing: 14px;
                                                    VerticalLayout { alignment: center; AppIcon { size: 34px; icon: app.icon; tint: app.tint; } }
                                                    VerticalLayout {
                                                        alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                        Text { text: app.name; color: Theme.ink; font-size: 14px; font-weight: 600; overflow: elide; }
                                                        Text { text: app.summary; color: Theme.ink-3; font-size: 12px; overflow: elide; }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center; spacing: 7px; width: 200px;
                                                        HorizontalLayout {
                                                            Text { text: app.focused; color: Theme.ink; font-size: 14px; font-weight: 600; font-family: Theme.font-display; }
                                                            Text { text: round(app.focus-ratio * 100) + "%"; color: Theme.ink-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 1; }
                                                        }
                                                        ShareBar { ratio: app.focus-ratio; tint: app.tint; }
                                                    }
                                                }
                                                app-touch := TouchArea { mouse-cursor: pointer; clicked => { app-key.focus(); root.windows-expanded = false; root.app-detail-open = true; root.app-selected(app.original-index); } }
                                                app-key := FocusScope { width: 0px; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.windows-expanded = false; root.app-detail-open = true; root.app-selected(app.original-index); return accept; } return reject; } }
                                            }
                                        }
                                    }
                                    if root.page == 3 && root.stats-tab == 0 && root.filtered-apps.length == 0 : Rectangle {
                                        vertical-stretch: 1;
                                        Note {
                                            y: 40px; horizontal-alignment: center;
                                            text: root.apps-loading && root.apps.length == 0 ? (root.stats-all ? "正在统计全部记录…" : "正在统计这段时间…")
                                                : root.app-search == "" ? (root.stats-all ? "还没有应用记录。" : "这段时间没有应用记录。") : "没有匹配的应用，试试其他名称。";
                                        }
                                    }

                                    // A report of another range than the one chosen says so.
                                    if root.page == 3 && root.stats-tab == 2 && root.report-ready && root.report-stale : Rectangle {
                                        height: stale-row.preferred-height;
                                        border-radius: 10px;
                                        background: Theme.warn-soft;
                                        border-width: 1px; border-color: Theme.warn-line;
                                        stale-row := HorizontalLayout {
                                            padding: 10px; padding-left: 14px; spacing: 10px;
                                            VerticalLayout { alignment: center; Image { width: 16px; height: 16px; source: @image-url("icons/alert-triangle.svg"); colorize: Theme.warn; } }
                                            Text { text: root.report-stale-text; color: Theme.ink; font-size: 13px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                            Action { text: "为当前时段生成"; enabled: !root.action-busy; clicked => { root.report-generate(); } }
                                        }
                                    }
                                    if root.page == 3 && root.stats-tab == 2 && root.report-ready : HorizontalLayout {
                                        spacing: 12px;
                                        opacity: root.report-stale ? 0.55 : 1;
                                        Card {
                                            horizontal-stretch: 1;
                                            VerticalLayout { padding: 16px; spacing: 4px; Metric { label: "聚焦总计"; value: root.report-focus; icon: @image-url("icons/clock.svg"); } }
                                        }
                                        Card {
                                            horizontal-stretch: 1;
                                            VerticalLayout {
                                                padding: 16px; spacing: 4px;
                                                Metric { label: "数据覆盖"; value: root.report-coverage; icon: @image-url("icons/shield.svg"); }
                                                // What the report leaves out; opens the list of stretches.
                                                Rectangle {
                                                    height: coverage-note.preferred-height;
                                                    accessible-role: button;
                                                    accessible-label: root.report-coverage-note + (root.report-gaps-open ? "，收起明细" : "，查看明细");
                                                    accessible-action-default => { root.report-gaps-open = !root.report-gaps-open; }
                                                    coverage-note := HorizontalLayout {
                                                        spacing: 4px;
                                                        Text { text: root.report-coverage-note; color: gaps-touch.has-hover && root.report-gaps.length > 0 ? Theme.brand-ink : Theme.ink-3; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                                                        if root.report-gaps.length > 0 : Image { width: 12px; height: 12px; y: 2px; source: root.report-gaps-open ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); colorize: Theme.ink-3; }
                                                    }
                                                    gaps-touch := TouchArea { enabled: root.report-gaps.length > 0; mouse-cursor: pointer; clicked => { root.report-gaps-open = !root.report-gaps-open; } }
                                                }
                                            }
                                        }
                                        Card {
                                            horizontal-stretch: 1;
                                            VerticalLayout {
                                                padding: 16px; spacing: 4px;
                                                Metric { label: "键盘"; value: root.report-input; icon: @image-url("icons/keyboard.svg"); }
                                                Text { text: root.report-input-note; color: Theme.ink-3; font-size: 12px; wrap: word-wrap; }
                                            }
                                        }
                                        Card {
                                            horizontal-stretch: 1;
                                            VerticalLayout {
                                                padding: 16px; spacing: 4px;
                                                Metric { label: "快照"; value: root.report-snapshots; icon: @image-url("icons/photo.svg"); }
                                                Text { text: root.report-snapshot-note; color: Theme.ink-3; font-size: 12px; wrap: word-wrap; }
                                            }
                                        }
                                    }
                                    if root.page == 3 && root.stats-tab == 2 && root.report-ready && root.report-gaps-open && root.report-gaps.length > 0 : Card {
                                        height: min(gap-list.preferred-height, 220px);
                                        ScrollView {
                                            gap-list := VerticalLayout {
                                                padding: 12px; padding-left: 16px; spacing: 4px;
                                                for gap in root.report-gaps : Text { text: gap; color: Theme.ink-2; font-size: 12px; }
                                            }
                                        }
                                    }
                                    if root.page == 3 && root.stats-tab == 2 && root.report-ready : HorizontalLayout {
                                        spacing: 6px;
                                        SettingsHeader { text: "应用聚焦"; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Action { quiet: true; text: "导出 JSON"; icon: @image-url("icons/download.svg"); clicked => { root.report-export(0); } }
                                        Action { quiet: true; text: "导出 CSV"; icon: @image-url("icons/download.svg"); clicked => { root.report-export(1); } }
                                    }
                                    if root.page == 3 && root.stats-tab == 2 && root.report-ready && root.report-apps.length > 0 : ListView {
                                        vertical-stretch: 1;
                                        opacity: root.report-stale ? 0.55 : 1;
                                        for app in root.report-apps : Rectangle {
                                            height: 60px;
                                            HorizontalLayout {
                                                padding-left: 4px; padding-right: 4px; spacing: 14px;
                                                VerticalLayout { alignment: center; AppIcon { size: 32px; icon: app.icon; tint: app.tint; } }
                                                VerticalLayout {
                                                    alignment: center; spacing: 3px; horizontal-stretch: 1;
                                                    Text { text: app.name; color: Theme.ink; font-size: 14px; font-weight: 600; overflow: elide; }
                                                    Text { text: app.summary; color: Theme.ink-3; font-size: 12px; overflow: elide; }
                                                }
                                                VerticalLayout {
                                                    alignment: center; spacing: 7px; width: 200px;
                                                    HorizontalLayout {
                                                        Text { text: app.focused; color: Theme.ink; font-size: 14px; font-weight: 600; font-family: Theme.font-display; }
                                                        Text { text: round(app.ratio * 100) + "%"; color: Theme.ink-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 1; }
                                                    }
                                                    ShareBar { ratio: app.ratio; tint: app.tint; }
                                                }
                                            }
                                            Rule { y: parent.height - 1px; }
                                        }
                                    }
                                    if root.page == 3 && root.stats-tab == 2 && root.report-ready && root.report-apps.length == 0 : Rectangle {
                                        vertical-stretch: 1;
                                        Note { y: 24px; text: "这段时间没有应用记录。"; horizontal-alignment: center; }
                                    }
                                    if root.page == 3 && root.stats-tab == 2 && root.report-ready : Note { text: root.report-footer; font-size: 11px; color: Theme.ink-4; }
                                    // Before a report: what generating one does, or why it failed.
                                    if root.page == 3 && root.stats-tab == 2 && !root.report-ready : Card {
                                        height: report-note.preferred-height;
                                        report-note := HorizontalLayout {
                                            padding: 16px; spacing: 12px;
                                            VerticalLayout { alignment: start; Image { width: 18px; height: 18px; source: @image-url("icons/info-circle.svg"); colorize: Theme.ink-3; } }
                                            Note { text: root.report-summary; color: Theme.ink-2; horizontal-stretch: 1; }
                                        }
                                    }
                                    if root.page == 3 && root.stats-tab == 2 && !root.report-ready : Rectangle { vertical-stretch: 1; }
                                    if root.page == 3 && root.stats-tab == 1 : CollectionPanel { vertical-stretch: 1; }

                                }
                            }

                            // Room for a docked detail pane; the panes themselves are drawn above.
                            Rectangle {
                                width: root.detail-docked ? root.detail-width : 0px;
                                animate width { duration: 220ms; easing: ease-out; }
                            }
                        }

                        // ───── Details on demand ─────
                        // Slides in when an activity is picked, out when closed.
                        if root.page == 0 : DetailDrawer {
                            x: parent.width - self.width; y: 0px; height: parent.height;
                            floating: !root.detail-docked;
                            width: root.detail-open ? 380px : 0px;
                            animate width { duration: 220ms; easing: ease-out; }
                            DetailPane {
                                x: 0px; width: 380px;
                                title: "活动详情";
                                opacity: root.detail-open ? 1 : 0;
                                animate opacity { duration: 200ms; easing: ease-out; }
                                close => { root.close-detail(); }
                                HorizontalLayout {
                                    spacing: 12px;
                                    AppIcon { size: 44px; icon: root.detail-icon; tint: root.detail-tint; }
                                    VerticalLayout { alignment: center; spacing: 3px; Text { text: root.detail-name; color: Theme.ink; font-size: 16px; font-weight: 600; wrap: word-wrap; } Note { text: root.detail-when; } }
                                }
                                // What to do with this stretch, before the details.
                                HorizontalLayout {
                                    spacing: 6px;
                                    Action { text: "快照"; icon: @image-url("icons/photo.svg"); accessible-label: "查看这段的快照"; clicked => { root.act-on-activity(root.history-selected, 0); } }
                                    Action { text: "规则"; icon: @image-url("icons/adjustments-horizontal.svg"); accessible-label: "这个应用的规则"; clicked => { root.act-on-activity(root.history-selected, 2); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Card {
                                    height: span-card.preferred-height;
                                    span-card := VerticalLayout {
                                        padding: 16px; spacing: 6px;
                                        Eyebrow { text: "持续"; }
                                        Figure { text: root.detail-duration; }
                                        Note { text: root.detail-loading ? "正在读取各应用的时间…" : root.detail-note; }
                                        Rectangle { height: 6px; }
                                        if !root.detail-loading : AppTimes { app: root.detail-main; }
                                    }
                                }
                                if root.detail-interleaved.length > 0 : SettingsHeader { text: "穿插切换（" + root.detail-interleaved.length + "）"; }
                                if root.detail-interleaved.length > 0 : VerticalLayout {
                                    spacing: 4px;
                                    for app in root.detail-interleaved : ParticipantItem { app: app; }
                                }
                                if root.detail-same-screen.length > 0 : SettingsHeader { text: "同屏显示（" + root.detail-same-screen.length + "）"; }
                                if root.detail-same-screen.length > 0 : VerticalLayout {
                                    spacing: 4px;
                                    for app in root.detail-same-screen : ParticipantItem { app: app; }
                                }
                                Card {
                                    height: input-card.preferred-height;
                                    input-card := HorizontalLayout {
                                        padding: 16px; spacing: 12px;
                                        Metric { label: "键盘"; value: root.detail-keyboard; icon: @image-url("icons/keyboard.svg"); horizontal-stretch: 1; }
                                        Rectangle { width: 1px; background: Theme.line; }
                                        Metric { label: "鼠标点击"; value: root.detail-mouse; icon: @image-url("icons/mouse.svg"); horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                        if root.app-detail : DetailDrawer {
                            x: parent.width - self.width; y: 0px; height: parent.height;
                            floating: !root.detail-docked;
                            width: 360px;
                            DetailPane {
                                x: 0px;
                                title: "应用详情";
                                close => { root.close-detail(); }
                                HorizontalLayout {
                                    spacing: 12px;
                                    AppIcon { size: 44px; icon: root.selected-icon; tint: root.selected-tint; }
                                    VerticalLayout { alignment: center; spacing: 3px; Text { text: root.selected-name; color: Theme.ink; font-size: 16px; font-weight: 600; wrap: word-wrap; } Note { text: root.apps-range; } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    // The timeline's search finds this application's activities.
                                    Action {
                                        text: "在时间线中查看"; icon: @image-url("icons/clock.svg");
                                        clicked => {
                                            root.app-detail-open = false;
                                            root.history-query = root.selected-name;
                                            root.navigate(0);
                                            root.history-search(root.selected-name);
                                        }
                                    }
                                    Action { text: "规则"; icon: @image-url("icons/adjustments-horizontal.svg"); accessible-label: "这个应用的规则"; clicked => { root.open-settings(2); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Card {
                                    height: focus-card.preferred-height;
                                    focus-card := VerticalLayout {
                                        padding: 16px; spacing: 8px;
                                        Eyebrow { text: root.stats-all ? "累计聚焦" : "所选范围聚焦"; }
                                        Figure { text: root.focused-value; }
                                        // Where in the range the application was open, shown and focused.
                                        Rectangle {
                                            height: 16px; border-radius: 4px; background: Theme.surface-2; clip: true;
                                            for segment in root.segments : Rectangle {
                                                x: segment.offset * parent.width; width: max(1px, segment.width * parent.width);
                                                y: segment.kind == 2 ? 0px : segment.kind == 1 ? 4px : 7px;
                                                height: segment.kind == 2 ? parent.height : segment.kind == 1 ? 8px : 2px;
                                                background: segment.kind == 2 ? root.selected-tint : segment.kind == 1 ? root.selected-tint.with-alpha(0.35) : Theme.ink-4;
                                            }
                                        }
                                        HorizontalLayout {
                                            Text { text: root.segments-start; color: Theme.ink-3; font-size: 11px; }
                                            Text { text: root.segments-end; color: Theme.ink-3; font-size: 11px; horizontal-alignment: right; horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            HorizontalLayout { spacing: 5px; VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 2px; background: root.selected-tint; } } Note { text: "聚焦"; font-size: 11px; } }
                                            HorizontalLayout { spacing: 5px; VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 2px; background: root.selected-tint.with-alpha(0.35); } } Note { text: "显示"; font-size: 11px; } }
                                            HorizontalLayout { spacing: 5px; VerticalLayout { alignment: center; Rectangle { width: 10px; height: 2px; background: Theme.ink-4; } } Note { text: "后台"; font-size: 11px; } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }
                                Card {
                                    height: app-facts.preferred-height;
                                    app-facts := VerticalLayout {
                                        padding-left: 14px; padding-right: 14px; padding-top: 6px; padding-bottom: 6px;
                                        DetailRow { label: "打开"; value: root.opened-value; }
                                        DetailRow { label: "显示"; value: root.displayed-value; }
                                        DetailRow { label: "后台"; value: root.background-value; }
                                        Rule { }
                                        DetailRow { label: "键盘"; value: root.keyboard-value; }
                                        DetailRow { label: "鼠标"; value: root.mouse-value; }
                                    }
                                }
                                // Windows by when they were open, longest focus first.
                                if root.windows-total > 0 : VerticalLayout {
                                    spacing: 4px;
                                    SettingsHeader { text: "窗口（" + root.windows-total + "）"; }
                                    VerticalLayout { spacing: 2px; for item in root.windows : WindowItem { item: item; } }
                                    if root.windows-total > root.windows.length || root.windows-expanded : HorizontalLayout {
                                        Action {
                                            quiet: true;
                                            text: root.windows-expanded ? "只显示聚焦最长的几个" : "显示全部 " + root.windows-total + " 个窗口";
                                            clicked => { root.windows-expanded = !root.windows-expanded; root.app-selected(root.selected-index); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }

                    }
                }
            }
        }
    }

    // Settings float above the window instead of replacing the page underneath.
    if root.settings-open : Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { root.close-settings(); } }
        settings-keys := FocusScope {
            // Not in `init`; see ConfirmationDialog.
            Timer { interval: 1ms; triggered => { settings-keys.focus(); self.running = false; } }
            capture-key-pressed(event) => {
                if event.text == Key.Escape && !root.any-modal-open { root.close-settings(); return accept; }
                return reject;
            }
            Rectangle {
                width: min(1100px, parent.width - 64px);
                height: min(800px, parent.height - 48px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.layer;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 48px;
                drop-shadow-offset-y: 18px;
                drop-shadow-color: Theme.shadow-strong;
                clip: true;
                // Clicks inside the sheet must not reach the backdrop.
                TouchArea { }
                VerticalLayout {
                    HorizontalLayout {
                        height: 56px;
                        padding-left: 24px; padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout { alignment: center; Image { width: 18px; height: 18px; source: @image-url("icons/settings.svg"); colorize: Theme.ink-2; } }
                        Text { text: "设置"; color: Theme.ink; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Action { quiet: true; icon: @image-url("icons/x.svg"); accessible-label: "关闭设置"; clicked => { root.close-settings(); } } }
                    }
                    Rule { }
                HorizontalLayout {
                    padding: 24px; padding-top: 18px;
                    spacing: 28px;
                    VerticalLayout {
                        width: 200px; spacing: 3px; alignment: start;
                        NavItem { text: "常规"; icon: @image-url("icons/settings.svg"); selected: root.settings-tab == 6; clicked => { root.pick-settings(6); } }
                        NavItem { text: "记录与隐私"; icon: @image-url("icons/shield.svg"); selected: root.settings-tab == 0; clicked => { root.pick-settings(0); } }
                        NavItem { text: "快照"; icon: @image-url("icons/camera.svg"); selected: root.settings-tab == 1; clicked => { root.pick-settings(1); } }
                        NavItem { text: "应用规则"; icon: @image-url("icons/ban.svg"); selected: root.settings-tab == 2; clicked => { root.pick-settings(2); } }
                        NavItem { text: "数据与存储"; icon: @image-url("icons/database.svg"); selected: root.settings-tab == 3; clicked => { root.pick-settings(3); } }
                        NavItem { text: "关于"; icon: @image-url("icons/info-circle.svg"); selected: root.settings-tab == 5; clicked => { root.pick-settings(5); } }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        max-width: 820px;
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.settings-tab == 6 ? "常规" : root.settings-tab == 0 ? "记录与隐私" : root.settings-tab == 1 ? "快照" : root.settings-tab == 2 ? "应用规则" : root.settings-tab == 3 ? "数据与存储" : "关于";
                                color: Theme.ink; font-size: 20px; font-weight: 600;
                            }
                            Note {
                                text: root.settings-tab == 6 ? "设置 Timelens 的外观与启动方式。"
                                    : root.settings-tab == 0 ? "Timelens 记录什么、不记录什么。"
                                    : root.settings-tab == 1 ? "定时拍摄屏幕快照，帮你回忆当时在做什么。"
                                    : root.settings-tab == 2 ? "为单个应用设置排除、合并显示或删除历史。"
                                    : root.settings-tab == 3 ? "保留时长、备份、导出与存储位置。"
                                    : "版本、更新与项目信息。";
                            }
                        }

                        if root.settings-tab == 6 : ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start; spacing: 10px; padding-right: 18px; padding-bottom: 20px;
                                SettingsHeader { text: "外观"; }
                                SettingsGroup {
                                    SettingRow {
                                        title: "主题";
                                        description: Theme.mode == 0 ? "跟随 Windows 的应用模式，切换后这里随之改变。" : "固定使用所选外观，不随 Windows 改变。";
                                        icon: Theme.dark ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg");
                                        Segmented {
                                            Segment { text: "跟随系统"; selected: Theme.mode == 0; clicked => { root.theme-mode-selected(0); } }
                                            Segment { text: "浅色"; icon: @image-url("icons/sun.svg"); selected: Theme.mode == 1; clicked => { root.theme-mode-selected(1); } }
                                            Segment { text: "深色"; icon: @image-url("icons/moon.svg"); selected: Theme.mode == 2; clicked => { root.theme-mode-selected(2); } }
                                        }
                                    }
                                }
                                SettingsHeader { text: "启动"; }
                                SettingsGroup {
                                    SettingRow {
                                        title: "开机自启动";
                                        description: "登录 Windows 后在后台启动 Timelens。";
                                        icon: @image-url("icons/player-play.svg");
                                        Switch {
                                            label: "开机自启动";
                                            checked: root.startup-enabled;
                                            enabled: root.startup-available && !root.startup-busy;
                                            toggled(on) => { root.startup-changed(on); }
                                        }
                                    }
                                }
                                Note { text: root.startup-status; color: Theme.ink-2; font-size: 12px; }
                                Note { text: "更改时需要管理员确认。关闭自启动不会停止当前记录，之后仍可手动打开 Timelens。"; font-size: 12px; }
                            }
                        }

                        if root.settings-tab == 0 : ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start; spacing: 10px; padding-right: 18px; padding-bottom: 20px;
                                Rectangle {
                                    height: privacy.preferred-height;
                                    border-radius: 12px;
                                    background: Theme.privacy-tint;
                                    border-width: 1px; border-color: Theme.brand-line;
                                    privacy := HorizontalLayout {
                                        padding: 16px; spacing: 14px;
                                        Rectangle {
                                            width: 36px; height: 36px; y: (parent.height - self.height) / 2;
                                            border-radius: 18px;
                                            background: Theme.brand.with-alpha(Theme.dark ? 0.2 : 0.12);
                                            border-width: 1px; border-color: Theme.brand-line;
                                            Image { width: 18px; height: 18px; source: @image-url("icons/lock.svg"); colorize: Theme.brand-ink; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px; horizontal-stretch: 1;
                                            Text { text: "记录只保存在这台电脑上"; color: Theme.ink; font-size: 14px; font-weight: 600; }
                                            Note { text: "加密存放在本机，不上传、不同步。"; color: Theme.ink-2; font-size: 12px; }
                                        }
                                    }
                                }
                                Rectangle { height: 8px; }
                                SettingsHeader { text: "记录"; }
                                SettingsGroup {
                                    SettingRow {
                                        title: "记录应用活动与输入";
                                        description: "关闭后保留明确的暂停区间，重新开启后不会补录。";
                                        icon: @image-url("icons/activity.svg");
                                        Switch {
                                            label: "记录应用活动与输入";
                                            checked: !CollectionState.paused;
                                            enabled: !CollectionState.busy;
                                            toggled(on) => { CollectionState.paused = !on; CollectionState.action(0); }
                                        }
                                    }
                                    Rule { }
                                    SettingRow { title: "采集器"; description: root.collector-status; icon: @image-url("icons/link.svg"); Dot { tone: root.recording-tone; } }
                                    Rule { }
                                    SettingRow {
                                        title: "应用规则";
                                        description: "按应用排除活动、输入或快照，或合并显示同一款软件。";
                                        icon: @image-url("icons/ban.svg");
                                        Action { text: "管理"; clicked => { root.show-settings(2); } }
                                    }
                                }
                                Rectangle { height: 8px; }
                                SettingsHeader { text: "从不记录"; }
                                SettingsGroup {
                                    SettingRow { title: "窗口标题、网址和文档名"; description: "只记录应用本身，不记录它打开了什么。"; icon: @image-url("icons/app-window.svg"); }
                                    Rule { }
                                    SettingRow { title: "输入的文字"; description: "键盘只统计物理按键的位置和次数。"; icon: @image-url("icons/keyboard.svg"); }
                                    Rule { }
                                    SettingRow { title: "安装与卸载程序"; description: "安装器、卸载器这类一次性程序不计入记录。"; icon: @image-url("icons/download.svg"); }
                                }
                            }
                        }

                        if root.settings-tab == 1 : ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start; spacing: 10px; padding-right: 18px; padding-bottom: 20px;
                                SettingsGroup {
                                    SettingRow {
                                        title: "定时快照";
                                        description: root.snapshot-enabled ? "每 " + (root.snapshot-interval-minutes == 60 ? "1 小时" : root.snapshot-interval-minutes + " 分钟") + "拍一张，只保存在本机。" : "已关闭，仍可在快照页手动拍一张。";
                                        icon: @image-url("icons/camera.svg");
                                        Switch { label: "定时快照"; checked: root.snapshot-enabled; toggled(on) => { root.snapshot-toggle-enabled(); } }
                                    }
                                }
                                Rectangle { height: 8px; }
                                SettingsHeader { text: "拍摄"; }
                                SettingsGroup {
                                    SettingRow {
                                        title: "拍摄间隔";
                                        description: root.snapshot-enabled ? "每隔多久拍一张。" : "开启定时快照后生效。";
                                        icon: @image-url("icons/clock.svg");
                                        Segmented {
                                            for minutes in [1, 3, 5, 10, 15, 30, 60] : Segment {
                                                text: minutes == 60 ? "1 小时" : minutes + " 分";
                                                accessible-label: minutes == 60 ? "1 小时" : minutes + " 分钟";
                                                enabled: root.snapshot-enabled;
                                                selected: root.snapshot-interval-minutes == minutes;
                                                clicked => { root.snapshot-interval-selected(minutes); }
                                            }
                                        }
                                    }
                                    Rule { }
                                    SettingRow {
                                        title: "拍摄的屏幕";
                                        description: "单屏时优先拍聚焦窗口所在的显示器。";
                                        icon: @image-url("icons/layout-grid.svg");
                                        Segmented {
                                            Segment { text: "当前显示器"; selected: !root.snapshot-all-displays; clicked => { if root.snapshot-all-displays { root.snapshot-toggle-target(); } } }
                                            Segment { text: "全部显示器"; selected: root.snapshot-all-displays; clicked => { if !root.snapshot-all-displays { root.snapshot-toggle-target(); } } }
                                        }
                                    }
                                    Rule { }
                                    SettingRow {
                                        title: "不拍摄某些应用";
                                        description: "在应用规则中为应用开启“不拍摄快照”。";
                                        icon: @image-url("icons/ban.svg");
                                        Action { text: "应用规则"; clicked => { root.show-settings(2); } }
                                    }
                                }
                                Rectangle { height: 8px; }
                                SettingsHeader { text: "保留"; }
                                SettingsGroup {
                                    SettingRow {
                                        title: "图片保留时长";
                                        description: "空间上限 " + root.snapshot-capacity + "，超出时先清理最早的图片。";
                                        icon: @image-url("icons/history.svg");
                                        Segmented {
                                            Segment { text: "7 天"; selected: root.snapshot-retention-days == 7; clicked => { root.choose-snapshot-retention(7); } }
                                            Segment { text: "30 天"; selected: root.snapshot-retention-days == 30; clicked => { root.choose-snapshot-retention(30); } }
                                            Segment { text: "90 天"; selected: root.snapshot-retention-days == 90; clicked => { root.choose-snapshot-retention(90); } }
                                            Segment { text: "1 年"; selected: root.snapshot-retention-days == 365; clicked => { root.choose-snapshot-retention(365); } }
                                            Segment { text: "永久"; selected: root.snapshot-retention-days == 0; clicked => { root.snapshot-retention-selected(0); } }
                                        }
                                    }
                                }
                                Note { text: "快照只保存在本机，不会发送到任何地方。"; font-size: 12px; }
                            }
                        }

                        if root.settings-tab == 2 : CollectionPanel { vertical-stretch: 1; }

                        if root.settings-tab == 3 : ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start; spacing: 10px; padding-right: 18px; padding-bottom: 20px;
                                SettingsHeader { text: "活动数据保留"; }
                                SettingsGroup {
                                    SettingRow {
                                        title: "保留时长";
                                        description: root.retention-value + "\n" + root.retention-usage;
                                        icon: @image-url("icons/history.svg");
                                        Segmented {
                                            Segment { text: "7 天"; selected: root.retention-days == 7; enabled: !root.action-busy; clicked => { root.choose-retention(7); } }
                                            Segment { text: "30 天"; selected: root.retention-days == 30; enabled: !root.action-busy; clicked => { root.choose-retention(30); } }
                                            Segment { text: "90 天"; selected: root.retention-days == 90; enabled: !root.action-busy; clicked => { root.choose-retention(90); } }
                                            Segment { text: "永久"; selected: root.retention-days == 0; enabled: !root.action-busy; clicked => { root.retention-selected(0); } }
                                        }
                                    }
                                    Rule { }
                                    SettingRow {
                                        title: "空间上限";
                                        description: "无论保留多久，数据库超过上限时都会先清理最早的一天。快照图片另有上限。";
                                        icon: @image-url("icons/database.svg");
                                        Segmented {
                                            Segment { text: "100 MiB"; selected: root.retention-mib == 100; enabled: !root.action-busy; clicked => { root.choose-space(100); } }
                                            Segment { text: "500 MiB"; selected: root.retention-mib == 500; enabled: !root.action-busy; clicked => { root.choose-space(500); } }
                                            Segment { text: "2 GiB"; selected: root.retention-mib == 2048; enabled: !root.action-busy; clicked => { root.choose-space(2048); } }
                                        }
                                    }
                                    Rule { }
                                    SettingRow {
                                        title: "按当前策略清理";
                                        description: "不会删除你导出到其他位置的文件。";
                                        icon: @image-url("icons/refresh.svg");
                                        Action { text: "立即清理"; enabled: !root.action-busy; clicked => { root.run-cleanup(); } }
                                    }
                                }
                                Rectangle { height: 10px; }
                                DataPanel { export-range: root.range-title; storage-status: root.storage-status; }
                                Rectangle { height: 10px; }
                                SettingsHeader { text: "危险操作"; color: Theme.danger; }
                                SettingsGroup {
                                    border-color: Theme.danger-line;
                                    SettingRow {
                                        title: "清空全部本地记录";
                                        description: "删除活动、输入、快照和报告，并轮换数据密钥。此操作无法撤销。";
                                        icon: @image-url("icons/trash.svg");
                                        Action { text: "清空…"; danger: true; enabled: !root.action-busy; clicked => { root.clear-confirm-open = true; } }
                                    }
                                }
                                if DataState.busy : StatusLine { busy: true; text: "正在处理，请稍候…"; }
                            }
                        }

                        if root.settings-tab == 5 : ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            AboutPage {
                                version: root.build-version;
                                check-updates => { root.check-updates(); }
                                open-project => { root.open-project(); }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 0; }
                }
                }
            }
        }
    }

    if CollectionState.confirm != 0 : ConfirmationDialog {
        z: 100;
        title: CollectionState.confirm == 1 ? "删除「" + CollectionState.app-name + "」的全部历史？" : "合并「" + CollectionState.app-name + "」与「" + CollectionState.apps[CollectionState.merge-index] + "」？";
        explanation: CollectionState.confirm == 1 ? CollectionState.impact : CollectionState.merge-preview;
        detail: CollectionState.confirm == 1 ? "匿名累计总数会保留，快照图片与外部文件也会保留。此操作无法撤销。" : "两者合并成一项显示，原始记录不改写，之后可以在「已有合并」里解除。";
        accept-text: CollectionState.confirm == 1 ? "删除历史" : "合并";
        dismissed => { CollectionState.confirm = 0; Theme.modal-open = false; settings-nav.focus(); }
        accepted => {
            if CollectionState.confirm == 1 {
                CollectionState.delete-confirmed = true;
                CollectionState.confirm = 0;
                CollectionState.action(5);
            } else {
                CollectionState.merge-confirmed = true;
                CollectionState.confirm = 0;
                CollectionState.action(3);
            }
            Theme.modal-open = false;
            settings-nav.focus();
        }
    }

    if DataState.restore-confirm != 0 : ConfirmationDialog {
        z: 100;
        title: DataState.restore-confirm == 1 ? "用这份备份替换当前全部记录？" : "退出并打开修复工具？";
        explanation: DataState.restore-confirm == 1
            ? "当前的活动、输入、快照和报告会被备份里的内容整体替换，不会合并，无法撤销。"
            : "Timelens 会退出并打开修复工具，修复完成前不会记录活动和输入。";
        detail: DataState.restore-confirm == 1 ? "想留一份现在的数据，先取消，在上方「创建便携备份」导出一份。" : "修复工具只在你确认后才会替换数据。";
        accept-text: DataState.restore-confirm == 1 ? "替换数据" : "退出并打开";
        dismissed => { DataState.restore-confirm = 0; Theme.modal-open = false; settings-nav.focus(); }
        accepted => {
            if DataState.restore-confirm == 1 {
                DataState.replace-confirmed = true;
                DataState.action(4);
            } else {
                DataState.action(10);
            }
            DataState.restore-confirm = 0;
            Theme.modal-open = false;
            settings-nav.focus();
        }
    }

    if root.clear-confirm-open : ConfirmationDialog {
        z: 100;
        title: "清空全部本地记录？";
        explanation: "活动、输入、快照和本地报告将被删除，数据密钥也会轮换。此操作无法撤销。";
        detail: "普通设置与排除规则保留。外部备份和导出文件不会删除。";
        accept-text: "确认清空";
        dismissed => { root.clear-confirm-open = false; Theme.modal-open = false; settings-nav.focus(); }
        accepted => { root.clear-confirm-open = false; Theme.modal-open = false; root.clear-all(); settings-nav.focus(); }
    }
    if root.delete-snapshot-confirm : ConfirmationDialog {
        z: 100;
        title: root.snapshot-selected-time != "" ? "删除 " + root.snapshot-selected-time + " 的快照？" : "删除这张快照图片？";
        explanation: "删除后图片无法恢复。";
        accept-text: "删除图片";
        // The viewer may still be open behind the dialog, so the page stays
        // disabled until it closes too.
        dismissed => { root.delete-snapshot-confirm = false; Theme.modal-open = root.any-modal-open; if !root.snapshot-viewer-open { snapshots-nav.focus(); } }
        accepted => {
            root.delete-snapshot-confirm = false;
            // The next image, or else the previous, takes the deleted one's
            // place, so the viewer goes on like Photos.
            root.snapshot-delete-selected();
            if root.snapshot-preview.width == 0 { root.snapshot-viewer-open = false; }
            Theme.modal-open = root.any-modal-open;
            if !root.snapshot-viewer-open { snapshots-nav.focus(); }
        }
    }
    if root.delete-checked-confirm : ConfirmationDialog {
        z: 100;
        title: "删除所选的 " + root.snapshot-checked-count + " 张快照图片？";
        explanation: "删除后图片无法恢复，时间线中保留对应的删除记录。";
        accept-text: "删除图片";
        dismissed => { root.delete-checked-confirm = false; Theme.modal-open = false; snapshots-nav.focus(); }
        accepted => { root.delete-checked-confirm = false; Theme.modal-open = false; root.snapshot-delete-checked(); snapshots-nav.focus(); }
    }
    if root.snapshot-viewer-open && root.snapshot-preview.width > 0 : PhotoViewer {
        z: 90;
        source: root.snapshot-preview;
        detail: root.snapshot-detail;
        position: root.snapshot-position;
        can-previous: root.snapshot-can-previous;
        can-next: root.snapshot-can-next;
        can-export: root.snapshot-deletable && !DataState.busy;
        can-delete: root.snapshot-deletable;
        active: !root.delete-snapshot-confirm;
        close => { root.snapshot-viewer-open = false; Theme.modal-open = root.any-modal-open; snapshots-nav.focus(); }
        step(offset) => { root.snapshot-step(root.snapshot-selected-index, offset); }
        export => { DataState.action(7); }
        delete => { root.delete-snapshot-confirm = true; }
    }
    if root.pending-space-mib >= 0 : ConfirmationDialog {
        z: 100;
        title: "把空间上限降到 " + (root.pending-space-mib >= 1024 ? (root.pending-space-mib / 1024) + " GiB" : root.pending-space-mib + " MiB") + "？";
        explanation: "记录已用约 " + root.retention-used-mib + " MiB，超过新的上限。最早的活动、输入明细和本地报告会按天立即删除，直到低于上限，无法恢复。";
        detail: "永久累计的输入总数保留。快照使用自己的上限。外部备份和导出文件不会删除。";
        accept-text: "删除并降低上限";
        dismissed => { root.pending-space-mib = -1; Theme.modal-open = false; settings-nav.focus(); }
        accepted => {
            root.retention-space-selected(root.pending-space-mib);
            root.pending-space-mib = -1;
            Theme.modal-open = false;
            settings-nav.focus();
        }
    }

    if root.retention-confirm-open : ConfirmationDialog {
        z: 100;
        title: root.pending-retention-snapshots ? "缩短快照图片保留期？" : "缩短活动数据保留期？";
        explanation: root.pending-retention-snapshots
            ? "早于 " + root.pending-retention-days + " 天的快照图片会立即删除，无法恢复。时间线中保留对应的清理记录。"
            : root.retention-cutoff(root.pending-retention-days) + " 之前的应用活动、输入明细和本地报告会立即删除，无法恢复。";
        detail: root.pending-retention-snapshots
            ? "活动记录使用自己的保留策略，不受影响。外部备份和导出文件不会删除。"
            : "永久累计的输入总数保留。快照使用自己的保留策略。外部备份和导出文件不会删除。";
        accept-text: "删除并缩短";
        dismissed => {
            root.pending-retention-days = -1;
            Theme.modal-open = false;
            settings-nav.focus();
        }
        accepted => {
            if root.pending-retention-snapshots { root.snapshot-retention-selected(root.pending-retention-days); } else { root.retention-selected(root.pending-retention-days); }
            root.pending-retention-days = -1;
            Theme.modal-open = false;
            settings-nav.focus();
        }
    }

    if DataState.move-phase != 0 : MoveDialog {
        z: 100;
        closed => { DataState.move-phase = 0; settings-nav.focus(); }
    }

    // The result of the last action, above pages, settings and dialogs.
    if root.action-status != "" : toast-box := Rectangle {
        private property <int> kind: root.status-kind(root.action-status);
        private property <string> path: root.status-path(root.action-status);
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 24px;
        width: min(parent.width - 48px, toast.preferred-width);
        height: toast.preferred-height;
        border-radius: 12px;
        background: Theme.toast;
        drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow-strong;
        // Clicks on the toast stay on it.
        toast-touch := TouchArea {
            changed has-hover => { root.toast-hover = self.has-hover; root.arm-toast(); }
        }
        toast := HorizontalLayout {
            padding-left: 14px; padding-right: 6px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 16px; height: 16px;
                    source: toast-box.kind == 2 ? @image-url("icons/alert-triangle.svg") : toast-box.kind == 1 ? @image-url("icons/clock.svg") : @image-url("icons/check.svg");
                    colorize: toast-box.kind == 2 ? #ffb4a8 : #ffffffb3;
                }
            }
            Text { text: root.action-status; color: Theme.on-tooltip; font-size: 13px; vertical-alignment: center; wrap: word-wrap; max-width: 520px; }
            if toast-box.path != "" : Rectangle {
                width: open-label.preferred-width + 20px; height: 30px; border-radius: 8px;
                background: open-touch.has-hover ? #ffffff2e : #ffffff1a;
                accessible-role: button;
                accessible-label: "打开文件夹";
                accessible-action-default => { root.open-folder(toast-box.path); }
                open-label := Text { text: "打开文件夹"; color: Theme.on-tooltip; font-size: 13px; vertical-alignment: center; }
                open-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-folder(toast-box.path); } }
            }
            Rectangle {
                width: 30px; height: 30px; border-radius: 8px;
                background: dismiss.has-hover ? #ffffff1f : transparent;
                accessible-role: button;
                accessible-label: "关闭提示";
                accessible-action-default => { root.action-status = ""; }
                Image { width: 14px; height: 14px; source: @image-url("icons/x.svg"); colorize: #ffffffb3; }
                dismiss := TouchArea { mouse-cursor: pointer; clicked => { root.action-status = ""; } }
            }
        }
    }

    // An invisible layer over the whole window. Changing it marks every pixel
    // dirty, so the software renderer repaints all of the window after a restore
    // (see window_chrome::repaint_after_restore). It takes no input.
    Rectangle {
        background: Math.mod(root.repaint-epoch, 2) == 0 ? #ffffff00 : #ffffff01;
    }
}
